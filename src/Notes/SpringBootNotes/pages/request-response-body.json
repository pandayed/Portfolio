    {
      "id": "20824eb1-ed54-8015-9945-ee0155655bc4",
      "type": "text",
      "richText": [
        [
          "@RequestBody",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " is used to bind a full JSON request body to a Java object, typically in POST or PUT methods. "
        ],
        [
          "@RequestParam",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " extracts values from query parameters (like "
        ],
        [
          "?name=John",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "), and "
        ],
        [
          "@PathVariable",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " binds values directly from the URL path (like "
        ],
        [
          "/users/5",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "). Each is used depending on where the data comes from in the HTTP request."
        ]
      ]
