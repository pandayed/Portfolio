      "type": "code",
      "richText": [
        [
          "// User.java (model class)\npublic class User {\n    private String name;\n    private int age;\n\n    // Getters and Setters (required for Spring to bind JSON to this object)\n    public String getName() { return name; }\n    public void setName(String name) { this.name = name; }\n\n    public int getAge() { return age; }\n    public void setAge(int age) { this.age = age; }\n}\n"
        ]
      ],
      "language": "Java"
    },
    {
      "id": "20824eb1-ed54-80b7-a7d9-ccda64eb5649",
      "type": "code",
      "richText": [
        [
          "// UserController.java\nimport org.springframework.web.bind.annotation.*;\n\n@RestController\n@RequestMapping(\"/users\")\npublic class UserController {\n\n    // Example 1: Get user by name (query param)\n    @GetMapping(\"/get\")\n    public String getUserByName(@RequestParam String name) {\n        return \"User name is: \" + name;\n    }\n\n    // Example 2: Get user by ID (URL path variable)\n    @GetMapping(\"/{id}\")\n    public String getUserById(@PathVariable int id) {\n        return \"Fetching user with ID: \" + id;\n    }\n\n    // Example 3: Create a user (JSON body)\n    @PostMapping(\"/create\")\n    public String createUser(@RequestBody User user) {\n        return \"User created: \" + user.getName() + \", Age: \" + user.getAge();\n    }\n}\n"
        ]
      ],
      "language": "Java"
    },
