{
  "id": "20824eb1-ed54-80f1-9e13-e5378147ebc7",
  "title": "Request and response bodies",
  "sourceUrl": "https://xpandeyed.notion.site/20824eb1ed5480f19e13e5378147ebc7",
  "blocks": [
    {
      "id": "request-response-body-lesson-0",
      "type": "header",
      "richText": [
        [
          "Message converters"
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-0-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "A Spring MVC message converter reads an HTTP body into a Java value or writes a Java value to an HTTP body."
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-0-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "spring-boot-starter-web",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " includes Jackson, the JSON library used by the default JSON converter in Spring Boot 3."
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-0-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "Spring Boot registers the usual message converters automatically."
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-0-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "A request DTO names the input fields that Jackson maps into the handler argument."
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-0-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "A response DTO names the fields the endpoint returns. It can differ from the request DTO."
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-1",
      "type": "header",
      "richText": [
        [
          "Request bodies with "
        ],
        [
          "@RequestBody",
          [
            [
              "c"
            ]
          ]
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-1-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "@RequestBody",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " tells Spring MVC to read the request body into that method argument."
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-1-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "For a JSON request, Spring selects the JSON converter using the content type and the argument type."
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-1-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "Jackson constructs the DTO before Spring calls the handler."
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-1-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "A body is required by default. A missing body or unreadable JSON normally produces "
        ],
        [
          "400 Bad Request",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-1-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "Conversion does not check rules such as a nonblank name. Request validation explains those checks after response handling."
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-2",
      "type": "header",
      "richText": [
        [
          "Response bodies"
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-2-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "@ResponseBody",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " tells Spring MVC to write a returned Java value to the response body."
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-2-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "@RestController",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " already applies this behavior to its handler methods."
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-2-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "The response type, available converters, and content negotiation determine the output format."
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-2-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "consumes",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " on a mapping restricts the accepted request content type."
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-2-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "produces",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " on a mapping declares the response content type supported by that handler."
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-2-note-5",
      "type": "bulleted_list",
      "richText": [
        [
          "An unsupported request content type normally produces "
        ],
        [
          "415 Unsupported Media Type",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-2-note-6",
      "type": "bulleted_list",
      "richText": [
        [
          "A request that accepts no supported response format normally receives "
        ],
        [
          "406 Not Acceptable",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "request-response-body-lesson-2-example-0",
      "type": "example",
      "example": {
        "title": "Convert a JSON request to a greeting response",
        "language": "java",
        "description": [
          "Each example is a separate project. All required application files appear in the tabs.",
          "Both DTO records are nested in the controller, so they require no separate files.",
          "The command runs after the application restarts and assumes port `8080`.",
          "`mvn spring-boot:run` starts the application from the directory containing `pom.xml`. Requests run in a second terminal."
        ],
        "code": "",
        "explanation": [
          "Jackson reads `name` from the JSON into `GreetingRequest`.",
          "Spring passes that record to `greet()`.",
          "The handler returns a `GreetingResponse`, not a prebuilt JSON string.",
          "Jackson writes its `message` field as JSON.",
          "This example has no validation constraints. A missing or blank `name` needs the rules introduced in Request validation."
        ],
        "commands": "curl -X POST http://localhost:8080/greetings \\\n  -H 'Content-Type: application/json' \\\n  -H 'Accept: application/json' \\\n  -d '{\"name\":\"Ada\"}'",
        "result": "{\"message\":\"Hello, Ada\"}",
        "files": [
          {
            "name": "src/main/java/com/example/demo/GreetingController.java",
            "language": "java",
            "code": "package com.example.demo;\n\nimport org.springframework.web.bind.annotation.PostMapping;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.RestController;\n\n@RestController\n@RequestMapping(\"/greetings\")\npublic class GreetingController {\n    public record GreetingRequest(String name) {}\n    public record GreetingResponse(String message) {}\n\n    @PostMapping(consumes = \"application/json\", produces = \"application/json\")\n    public GreetingResponse greet(@RequestBody GreetingRequest request) {\n        return new GreetingResponse(\"Hello, \" + request.name());\n    }\n}\n"
          },
          {
            "name": "pom.xml",
            "language": "text",
            "code": "<project xmlns=\"http://maven.apache.org/POM/4.0.0\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n         xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd\">\n    <modelVersion>4.0.0</modelVersion>\n    <parent>\n        <groupId>org.springframework.boot</groupId>\n        <artifactId>spring-boot-starter-parent</artifactId>\n        <version>3.5.16</version>\n        <relativePath/>\n    </parent>\n    <groupId>com.example</groupId>\n    <artifactId>demo</artifactId>\n    <version>1.0.0</version>\n    <properties><java.version>17</java.version></properties>\n    <dependencies>\n        <dependency>\n            <groupId>org.springframework.boot</groupId>\n            <artifactId>spring-boot-starter-web</artifactId>\n        </dependency>\n    </dependencies>\n    <build>\n        <finalName>demo</finalName>\n        <plugins>\n            <plugin>\n                <groupId>org.springframework.boot</groupId>\n                <artifactId>spring-boot-maven-plugin</artifactId>\n            </plugin>\n        </plugins>\n    </build>\n\n</project>\n"
          },
          {
            "name": "src/main/java/com/example/demo/DemoApplication.java",
            "language": "java",
            "code": "package com.example.demo;\n\nimport org.springframework.boot.SpringApplication;\nimport org.springframework.boot.autoconfigure.SpringBootApplication;\n\n@SpringBootApplication\npublic class DemoApplication {\n    public static void main(String[] args) {\n        SpringApplication.run(DemoApplication.class, args);\n    }\n}\n"
          }
        ]
      }
    }
  ],
  "summary": "Follow JSON through a message converter into a DTO and back into a response.",
