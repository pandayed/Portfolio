      "type": "text",
      "richText": [
        [
          "Spring Security",
          [
            [
              "b"
            ]
          ]
        ],
        [
          " is a framework that adds "
        ],
        [
          "authentication (who are you?)",
          [
            [
              "b"
            ]
          ]
        ],
        [
          " and "
        ],
        [
          "authorization (are you allowed to do this?)",
          [
            [
              "b"
            ]
          ]
        ],
        [
          " to Spring Boot applications. It protects web apps from unauthorized access — like a bouncer at the door."
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-80c9-b17a-e0ace6143c71",
      "type": "text",
      "richText": [
        [
          "In-memory authentication",
          [
            [
              "b"
            ]
          ]
        ],
        [
          " is a simple way to define users and passwords directly in the code — useful for testing or learning."
        ]
      ]
    },
