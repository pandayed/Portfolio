{
  "id": "20924eb1-ed54-80bf-82c8-d22225fd2135",
  "title": "Spring Security basics",
  "sourceUrl": "https://xpandeyed.notion.site/20924eb1ed5480bf82c8d22225fd2135",
  "blocks": [
    {
      "id": "20924eb1-ed54-8061-a676-d213d1dc6762",
      "type": "header",
      "richText": [
        [
          "Spring Security in a Boot application"
        ]
      ]
    },
    {
      "id": "security-basics-lesson-0-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "Spring Security runs security checks before Spring MVC calls a controller."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-0-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "These notes use servlet applications with Spring Boot 3.5 and Spring Security 6.5."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-0-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "spring-boot-starter-security",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " adds the security libraries."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-0-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "Boot registers the security infrastructure when those libraries are present."
        ]
      ]
    },
    {
      "id": "ed-security-version",
      "type": "header",
      "richText": [
        [
          "Default security"
        ]
      ]
    },
    {
      "id": "security-basics-lesson-1-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "Without custom security configuration, Boot protects application requests."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-1-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "Browser requests can show Spring Security's generated login page."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-1-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "Boot also enables HTTP Basic authentication in its default web configuration."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-1-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "Without a custom account configuration, Boot creates an in-memory account named "
        ],
        [
          "user",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-1-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "The startup log contains that account's generated password."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-1-note-5",
      "type": "bulleted_list",
      "richText": [
        [
          "The generated account is for development. The next authentication-and-authorization lesson replaces it with an explicit account."
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-8056-af30-f4a9ecc31d03",
      "type": "header",
      "richText": [
        [
          "Security filters"
        ]
      ]
    },
    {
      "id": "security-basics-lesson-2-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "A servlet "
        ],
        [
          "Filter",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " runs before the request reaches Spring MVC's "
        ],
        [
          "DispatcherServlet",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-2-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "Spring Security supplies filters for login, stored authentication, CSRF checks, and request permissions."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-2-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "A filter can reject a request before the controller runs."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-2-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "SecurityFilterChain",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " holds a request matcher and the ordered security filters for matching requests."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-2-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "FilterChainProxy",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " selects the first matching "
        ],
        [
          "SecurityFilterChain",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " for each request."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-2-note-5",
      "type": "bulleted_list",
      "richText": [
        [
          "HttpSecurity",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " is the builder that configures those filters."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-2-note-6",
      "type": "bulleted_list",
      "richText": [
        [
          "http.build()",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " creates the "
        ],
        [
          "SecurityFilterChain",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " bean from that configuration."
        ]
      ]
    },
    {
      "id": "ed-security-next",
      "type": "header",
      "richText": [
        [
          "A custom filter chain"
        ]
      ]
    },
    {
      "id": "security-basics-lesson-3-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "A "
        ],
        [
          "SecurityFilterChain",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " bean replaces Boot's default web security rules."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-3-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "It does not, by itself, replace Boot's generated account."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-3-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "authorizeHttpRequests",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " defines the request permission checks."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-3-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "authenticated()",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " requires a successfully authenticated user."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-3-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "formLogin",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " adds Spring Security's form-login handling and generated login page."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-3-note-5",
      "type": "bulleted_list",
      "richText": [
        [
          "Boot applications do not need "
        ],
        [
          "@EnableWebSecurity",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " just to activate the starter."
        ]
      ]
    },
    {
      "id": "security-basics-lesson-3-note-6",
      "type": "bulleted_list",
      "richText": [
        [
          "WebSecurityConfigurerAdapter",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " and "
        ],
        [
          "antMatchers",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " belong to older configurations. These notes use "
        ],
        [
          "SecurityFilterChain",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " and "
        ],
        [
          "requestMatchers",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-80b9-b4fd-edc0293754d0",
      "type": "example",
      "example": {
        "title": "Protect existing controllers with form login",
        "language": "java",
        "description": [
          "Each example is a separate project. All required application files appear in the tabs.",
          "`SecurityConfig.java` belongs in `com.example.demo` beneath the application's component scan.",
          "Opening `/employees` in a browser redirects to the generated login page.",
          "The development account is `user` with the generated password from the startup log."
        ],
        "code": "",
        "explanation": [
          "Spring calls `security` while creating beans at startup.",
          "The resulting filters run for requests. Spring does not call this bean method once per request.",
          "`anyRequest()` makes the authentication rule cover every request handled by this chain.",
          "The login filters handle the login page and form submission.",
          "A successful login allows Spring MVC to handle the protected endpoint.",
          "CSRF protection remains enabled.",
          "The next lesson explains the account lookup and password check. The browser-security lesson explains the saved login and CSRF token."
        ],
        "files": [
          {
            "name": "src/main/java/com/example/demo/SecurityConfig.java",
            "language": "java",
            "code": "package com.example.demo;\n\nimport org.springframework.context.annotation.Bean;\nimport org.springframework.context.annotation.Configuration;\nimport org.springframework.security.config.Customizer;\nimport org.springframework.security.config.annotation.web.builders.HttpSecurity;\nimport org.springframework.security.web.SecurityFilterChain;\n\n@Configuration\npublic class SecurityConfig {\n    @Bean\n    SecurityFilterChain security(HttpSecurity http) throws Exception {\n        return http\n            .authorizeHttpRequests(rules -> rules\n                .anyRequest().authenticated())\n            .formLogin(Customizer.withDefaults())\n            .build();\n    }\n}\n"
          },
          {
            "name": "src/main/java/com/example/demo/PageController.java",
            "language": "java",
            "code": "package com.example.demo;\nimport org.springframework.web.bind.annotation.GetMapping;\nimport org.springframework.web.bind.annotation.PostMapping;\nimport org.springframework.web.bind.annotation.RestController;\n@RestController\npublic class PageController {\n    @GetMapping(\"/\") public String home() { return \"Home\"; }\n    @GetMapping(\"/public/info\") public String info() { return \"Public information\"; }\n    @GetMapping(\"/admin/report\") public String admin() { return \"Admin report\"; }\n    @GetMapping(\"/employees\") public String employees() { return \"Employee list\"; }\n    @PostMapping(\"/employees\") public String create() { return \"Employee created\"; }\n}\n"
          },
          {
            "name": "pom.xml",
            "language": "text",
            "code": "<project xmlns=\"http://maven.apache.org/POM/4.0.0\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n         xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd\">\n    <modelVersion>4.0.0</modelVersion>\n    <parent>\n        <groupId>org.springframework.boot</groupId>\n        <artifactId>spring-boot-starter-parent</artifactId>\n        <version>3.5.16</version>\n        <relativePath/>\n    </parent>\n    <groupId>com.example</groupId>\n    <artifactId>demo</artifactId>\n    <version>1.0.0</version>\n    <properties><java.version>17</java.version></properties>\n    <dependencies>\n        <dependency>\n            <groupId>org.springframework.boot</groupId>\n            <artifactId>spring-boot-starter-web</artifactId>\n        </dependency>\n        <dependency>\n            <groupId>org.springframework.boot</groupId>\n            <artifactId>spring-boot-starter-security</artifactId>\n        </dependency>\n    </dependencies>\n    <build>\n        <finalName>demo</finalName>\n        <plugins>\n            <plugin>\n                <groupId>org.springframework.boot</groupId>\n                <artifactId>spring-boot-maven-plugin</artifactId>\n            </plugin>\n        </plugins>\n    </build>\n\n</project>\n"
          },
          {
            "name": "src/main/java/com/example/demo/DemoApplication.java",
            "language": "java",
            "code": "package com.example.demo;\n\nimport org.springframework.boot.SpringApplication;\nimport org.springframework.boot.autoconfigure.SpringBootApplication;\n\n@SpringBootApplication\npublic class DemoApplication {\n    public static void main(String[] args) {\n        SpringApplication.run(DemoApplication.class, args);\n    }\n}\n"
          }
        ],
        "commands": "mvn spring-boot:run"
      }
    }
  ],
