    {
      "id": "lombok-lesson-0",
      "type": "header",
      "richText": [
        [
          "Lombok and Spring"
        ]
      ]
    },
    {
      "id": "lombok-lesson-0-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "Lombok generates Java methods and constructors from annotations during compilation."
        ]
      ]
    },
    {
      "id": "lombok-lesson-0-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "Spring Boot does not require Lombok. Explicit Java constructors and methods work the same way."
        ]
      ]
    },
    {
      "id": "lombok-lesson-0-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "Lombok annotations belong to "
        ],
        [
          "lombok",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ". They do not register Spring beans."
        ]
      ]
    },
    {
      "id": "lombok-lesson-0-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "The build needs the Lombok dependency and annotation processing. The IDE also needs Lombok support to understand generated methods."
        ]
      ]
    },
    {
      "id": "lombok-lesson-1",
      "type": "header",
      "richText": [
        [
          "Generated members"
        ]
      ]
    },
    {
