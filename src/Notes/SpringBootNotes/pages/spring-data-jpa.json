{
  "id": "20924eb1-ed54-80e4-be00-c1bf8a7f3b5a",
  "title": "Spring Data JPA (CrudRepository, JpaRepository)",
  "sourceUrl": "https://xpandeyed.notion.site/20924eb1ed5480e4be00c1bf8a7f3b5a",
  "blocks": [
    {
      "id": "20924eb1-ed54-80d5-be15-dab9a9d334d3",
