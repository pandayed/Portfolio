      "richText": [
        [
          "How does Spring Boot handle JSON conversion in REST APIs?"
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-8007-b2ca-cc8feffe4b36",
      "type": "numbered_list",
      "richText": [
        [
          "What is "
        ],
        [
          "@RequestMapping",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " and how is it different from "
        ],
        [
          "@GetMapping",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " or "
        ],
        [
          "@PostMapping",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "?"
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-80a7-8f93-f1f9f8530a2f",
      "type": "numbered_list",
      "richText": [
        [
          "How do you extract parameters from the URL in Spring Boot REST controllers?"
        ]
      ]
    },
    {
