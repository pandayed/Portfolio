          "// src/main/java/com/example/demo/Customer.java\npackage com.example.demo;\n\nimport jakarta.persistence.Entity;\nimport jakarta.persistence.Id;\n\n@Entity\npublic class Customer {\n    @Id\n    private Long id;\n    private String name;\n    private String email;\n\n    // Getters & setters\n}\n"
        ]
      ],
      "language": "Java"
    },
    {
      "id": "20924eb1-ed54-80ea-a07f-f2e80caa6e91",
      "type": "code",
      "richText": [
        [
          "// src/main/java/com/example/demo/CustomerRepository.java\npackage com.example.demo;\n\nimport org.springframework.data.jpa.repository.JpaRepository;\n\npublic interface CustomerRepository extends JpaRepository<Customer, Long> {\n    // Spring will auto-implement basic CRUD methods\n}\n"
        ]
      ],
      "language": "Java"
    },
    {
      "id": "20924eb1-ed54-8084-b3c5-c90a0cfbaa2d",
      "type": "code",
      "richText": [
        [
          "// src/main/java/com/example/demo/DemoApplication.java\npackage com.example.demo;\n\nimport org.springframework.boot.SpringApplication;\nimport org.springframework.boot.autoconfigure.SpringBootApplication;\nimport org.springframework.boot.CommandLineRunner;\nimport org.springframework.context.annotation.Bean;\n\n@SpringBootApplication\npublic class DemoApplication {\n\n    public static void main(String[] args) {\n        SpringApplication.run(DemoApplication.class, args);\n    }\n\n    @Bean\n    public CommandLineRunner run(CustomerRepository repo) {\n        return args -> {\n            repo.save(new Customer(1L, \"Alice\", \"alice@example.com\"));\n            System.out.println(repo.findAll());\n        };\n    }\n}\n"
        ]
      ],
      "language": "Java"
    },
    {
      "id": "20924eb1-ed54-8097-9c25-f86a3092c79c",
      "type": "code",
      "richText": [
