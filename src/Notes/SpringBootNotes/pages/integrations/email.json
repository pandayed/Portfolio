    {
      "id": "integrations-email-lesson-1-example-0",
      "type": "example",
      "example": {
        "title": "Submit a plain-text digest",
        "language": "java",
        "description": [
          "Each tab names a file relative to the project root. Java `17` and Maven are required. `mvn spring-boot:run` starts this example after its external requirements are configured.",
          "The Spring Boot 3.5 project adds `org.springframework.boot:spring-boot-starter-mail` with the Boot-managed version.",
          "The provider supports authenticated SMTP with STARTTLS on port `587`.",
          "A provider with different requirements needs different connection settings.",
          "The environment supplies `MAIL_HOST`, `MAIL_USERNAME`, `MAIL_PASSWORD`, and `MAIL_FROM`.",
          "The provider must permit the sender address.",
          "An application service calls the injected `DigestMailService.send(recipient, summary)` after checking consent and recipient authorization."
        ],
        "code": "",
        "explanation": [
          "Boot supplies the configured `JavaMailSender`.",
          "Spring injects it into `DigestMailService`.",
          "`starttls.required` rejects a connection without the required TLS upgrade.",
          "TLS certificate validation must remain enabled.",
          "The three mail timeouts are in milliseconds.",
          "Each value limits that operation to five seconds.",
          "`setText` supplies plain text.",
          "`send` submits it to the SMTP server.",
          "A failed submission raises `MailException`.",
          "The service lets that failure reach its caller.",
          "This class is reused by the sentiment summary lesson.",
          "No controller or scheduled job is created here."
        ],
        "files": [
          {
            "name": "src/main/java/com/example/demo/DigestMailService.java",
            "language": "java",
            "code": "package com.example.demo;\n\nimport org.springframework.beans.factory.annotation.Value;\nimport org.springframework.mail.SimpleMailMessage;\nimport org.springframework.mail.javamail.JavaMailSender;\nimport org.springframework.stereotype.Service;\n\n@Service\npublic class DigestMailService {\n    private final JavaMailSender sender;\n    private final String from;\n\n    public DigestMailService(JavaMailSender sender,\n            @Value(\"${app.mail.from}\") String from) {\n        this.sender = sender;\n        this.from = from;\n    }\n\n    public void send(String recipient, String summary) {\n        var message = new SimpleMailMessage();\n        message.setFrom(from);\n        message.setTo(recipient);\n        message.setSubject(\"Your weekly journal summary\");\n        message.setText(summary);\n        sender.send(message);\n    }\n}\n"
          },
          {
            "name": "src/main/resources/application.properties",
            "language": "text",
            "code": "spring.mail.host=${MAIL_HOST}\nspring.mail.port=587\nspring.mail.username=${MAIL_USERNAME}\nspring.mail.password=${MAIL_PASSWORD}\nspring.mail.properties[mail.smtp.auth]=true\nspring.mail.properties[mail.smtp.starttls.enable]=true\nspring.mail.properties[mail.smtp.starttls.required]=true\nspring.mail.properties[mail.smtp.connectiontimeout]=5000\nspring.mail.properties[mail.smtp.timeout]=5000\nspring.mail.properties[mail.smtp.writetimeout]=5000\napp.mail.from=${MAIL_FROM}\n"
          },
          {
            "name": "src/main/java/com/example/demo/DemoApplication.java",
            "language": "java",
            "code": "package com.example.demo;\n\nimport org.springframework.boot.SpringApplication;\nimport org.springframework.boot.autoconfigure.SpringBootApplication;\n\n@SpringBootApplication\npublic class DemoApplication {\n    public static void main(String[] args) {\n        SpringApplication.run(DemoApplication.class, args);\n    }\n}\n"
          },
          {
            "name": "pom.xml",
            "language": "text",
            "code": "<project xmlns=\"http://maven.apache.org/POM/4.0.0\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n         xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd\">\n    <modelVersion>4.0.0</modelVersion>\n    <parent>\n        <groupId>org.springframework.boot</groupId>\n        <artifactId>spring-boot-starter-parent</artifactId>\n        <version>3.5.16</version>\n        <relativePath/>\n    </parent>\n    <groupId>com.example</groupId>\n    <artifactId>demo</artifactId>\n    <version>1.0.0</version>\n    <properties><java.version>17</java.version></properties>\n    <dependencies>\n        <dependency>\n            <groupId>org.springframework.boot</groupId>\n            <artifactId>spring-boot-starter-mail</artifactId>\n        </dependency>\n    </dependencies>\n    <build>\n        <finalName>demo</finalName>\n        <plugins>\n            <plugin>\n                <groupId>org.springframework.boot</groupId>\n                <artifactId>spring-boot-maven-plugin</artifactId>\n            </plugin>\n        </plugins>\n    </build>\n\n</project>\n"
          }
        ]
      }
    },
