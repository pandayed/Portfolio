      ]
    },
    {
      "id": "integrations-external-apis-lesson-0-note-0-part-1",
      "type": "bulleted_list",
      "richText": [
        [
          "The calling thread waits for the response."
        ]
      ]
    },
    {
      "id": "integrations-external-apis-lesson-0-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "Spring Boot 3.5 supplies a "
