      "richText": [
        [
          "🧪 3. Code Example"
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-80a5-9de9-d2bd3952dddd",
      "type": "text",
      "richText": [
        [
          "Here’s a complete example with a simulated \"User Not Found\" scenario."
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-8024-801d-db90e6d389b9",
      "type": "code",
      "richText": [
        [
          "// Custom Exception\npublic class UserNotFoundException extends RuntimeException {\n    public UserNotFoundException(String message) {\n        super(message);\n    }\n}\n\n// REST Controller\n@RestController\n@RequestMapping(\"/users\")\npublic class UserController {\n\n    @GetMapping(\"/{id}\")\n    public String getUser(@PathVariable int id) {\n        if (id != 1) {  // Simulating user not found\n            throw new UserNotFoundException(\"User with ID \" + id + \" not found\");\n        }\n        return \"User Found!\";\n    }\n}\n\n// Global Exception Handler\n@ControllerAdvice\npublic class GlobalExceptionHandler {\n\n    @ExceptionHandler(UserNotFoundException.class)\n    public ResponseEntity<String> handleUserNotFound(UserNotFoundException ex) {\n        return new ResponseEntity<>(ex.getMessage(), HttpStatus.NOT_FOUND);\n    }\n\n    // You can handle more exceptions like this\n}\n"
        ]
      ],
      "language": "Java"
    },
    {
      "id": "20924eb1-ed54-8062-b9be-f8c4f9b7a74f",
      "type": "text",
      "richText": [
        [
          "🔍 "
        ],
        [
          "Real-World Scenario",
          [
            [
              "b"
            ]
          ]
        ],
        [
          ": Instead of crashing the app or sending raw error logs to users, this setup returns:"
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-80e9-ad16-fbb2796e36f1",
      "type": "code",
      "richText": [
