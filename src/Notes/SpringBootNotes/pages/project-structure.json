  "blocks": [
    {
      "id": "structure-layout",
      "type": "header",
      "richText": [
        [
          "Project files"
        ]
      ]
    },
    {
      "id": "structure-layout-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "The generated project already contains the application class and its build configuration."
        ]
      ]
    },
    {
      "id": "structure-layout-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "The lessons add Java classes below "
        ],
        [
          "src/main/java/com/example/demo",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "structure-layout-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "Application settings belong in "
        ],
        [
          "src/main/resources/application.properties",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "structure-layout-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "Maven reads "
        ],
        [
          "pom.xml",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ". The Gradle alternative reads "
        ],
        [
          "build.gradle",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " or "
        ],
        [
          "build.gradle.kts",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "structure-layout-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "The generated wrapper runs the build tool version selected by the project."
        ]
      ]
    },
    {
      "id": "structure-layout-example-0",
      "type": "example",
      "example": {
        "title": "Locate the application files",
        "language": "text",
        "description": [
          "This directory tree shows the layout of a generated Maven Spring Boot project."
        ],
        "code": "demo/\n  pom.xml\n  mvnw\n  mvnw.cmd\n  src/main/java/com/example/demo/DemoApplication.java\n  src/main/resources/application.properties\n  src/test/java/com/example/demo/DemoApplicationTests.java",
        "explanation": [
          "`DemoApplication.java` remains in `com.example.demo` throughout the foundation lessons.",
          "A new class with `package com.example.demo;` belongs beside that file.",
          "`application.properties` starts empty if the application has no custom settings.",
          "The generated test file is not part of application startup. The testing chapter explains Spring test support."
        ]
      }
    },
    {
      "id": "project-structure-lesson-1",
      "type": "header",
      "richText": [
        [
          "Application package"
        ]
      ]
    },
    {
      "id": "project-structure-lesson-1-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "@SpringBootApplication",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " uses the application class\u2019s package as the default starting package for several Spring searches."
        ]
      ]
    },
    {
      "id": "project-structure-lesson-1-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "With "
        ],
        [
          "DemoApplication",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " in "
        ],
        [
          "com.example.demo",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ", application classes belong in that package or below it."
        ]
      ]
    },
    {
      "id": "project-structure-lesson-1-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "For example, "
        ],
        [
          "com.example.demo.greeting",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " is below the starting package. "
        ],
        [
          "com.example.other",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " is not."
        ]
      ]
    },
    {
      "id": "project-structure-lesson-1-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "This package placement lets Spring find application classes without an extra scan setting."
        ]
      ]
    },
    {
      "id": "project-structure-lesson-1-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "The beans lesson explains which classes Spring finds and what it does with them."
        ]
      ]
    },
    {
      "id": "project-structure-lesson-1-note-5",
      "type": "bulleted_list",
      "richText": [
        [
          "A folder named "
        ],
        [
          "service",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " has no Spring behavior by itself."
        ]
      ]
    }
  ]
}
