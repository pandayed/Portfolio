{
  "id": "20924eb1-ed54-8068-b645-ea1ea4bef013",
  "title": "Build and run with Maven or Gradle",
  "sourceUrl": "https://xpandeyed.notion.site/20924eb1ed548068b645ea1ea4bef013",
  "blocks": [
    {
      "id": "maven-gradle-lesson-0",
      "type": "header",
      "richText": [
        [
          "Spring Boot build plugins"
        ]
      ]
    },
    {
      "id": "maven-gradle-lesson-0-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "The Spring Boot build plugin runs the application and packages it with its runtime dependencies."
        ]
      ]
    },
    {
      "id": "maven-gradle-lesson-0-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "The Maven plugin is "
        ],
        [
          "spring-boot-maven-plugin",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ". The Gradle plugin is "
        ],
        [
          "org.springframework.boot",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "maven-gradle-lesson-0-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "The generated project configures the plugin for its build tool."
        ]
      ]
    },
    {
      "id": "maven-gradle-lesson-0-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "A starter supplies libraries to application code. A build plugin supplies build operations."
        ]
      ]
    },
    {
      "id": "maven-gradle-lesson-1",
      "type": "header",
      "richText": [
        [
          "Maven development commands"
        ]
      ]
    },
    {
      "id": "maven-gradle-lesson-1-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "spring-boot:run",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " starts the application from the Maven project."
        ]
      ]
    },
    {
      "id": "maven-gradle-lesson-1-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "package",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " builds the application artifact and normally runs the project\u2019s tests."
        ]
      ]
    },
    {
      "id": "maven-gradle-lesson-1-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "clean",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " removes previous build output. It does not start the application."
        ]
      ]
    },
    {
      "id": "maven-gradle-lesson-1-example-0",
      "type": "example",
      "example": {
        "title": "Run and package the Maven project",
        "language": "text",
        "description": [
          "The tabs contain the complete Maven application.",
          "The commands run from the directory containing `pom.xml`.",
          "Java 17 or later and Maven must be installed."
        ],
        "code": "",
        "explanation": [
          "The first command keeps the application running until it stops.",
          "After it stops, the second command writes build output under `target`.",
          "The packaging chapter explains the executable JAR and its `java -jar` command."
        ],
        "commands": "mvn spring-boot:run\n\n# After stopping the running application:\nmvn clean package",
        "files": [
          {
            "name": "pom.xml",
            "language": "text",
            "code": "<project xmlns=\"http://maven.apache.org/POM/4.0.0\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n         xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd\">\n    <modelVersion>4.0.0</modelVersion>\n    <parent>\n        <groupId>org.springframework.boot</groupId>\n        <artifactId>spring-boot-starter-parent</artifactId>\n        <version>3.5.16</version>\n        <relativePath/>\n    </parent>\n    <groupId>com.example</groupId>\n    <artifactId>demo</artifactId>\n    <version>1.0.0</version>\n    <properties><java.version>17</java.version></properties>\n    <dependencies>\n        <dependency>\n            <groupId>org.springframework.boot</groupId>\n            <artifactId>spring-boot-starter-web</artifactId>\n        </dependency>\n    </dependencies>\n    <build>\n        <finalName>demo</finalName>\n        <plugins>\n            <plugin>\n                <groupId>org.springframework.boot</groupId>\n                <artifactId>spring-boot-maven-plugin</artifactId>\n            </plugin>\n        </plugins>\n    </build>\n\n</project>\n"
          },
          {
            "name": "src/main/java/com/example/demo/DemoApplication.java",
            "language": "java",
            "code": "package com.example.demo;\n\nimport org.springframework.boot.SpringApplication;\nimport org.springframework.boot.autoconfigure.SpringBootApplication;\n\n@SpringBootApplication\npublic class DemoApplication {\n    public static void main(String[] args) {\n        SpringApplication.run(DemoApplication.class, args);\n    }\n}\n"
          }
        ]
      }
    },
    {
      "id": "maven-gradle-lesson-2",
      "type": "header",
      "richText": [
        [
          "Gradle alternative"
        ]
      ]
    },
    {
      "id": "maven-gradle-lesson-2-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "./gradlew bootRun",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " runs the same application in a generated Gradle project."
        ]
      ]
    },
    {
      "id": "maven-gradle-lesson-2-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "./gradlew build",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " runs the build and verification tasks."
        ]
      ]
    },
    {
      "id": "maven-gradle-lesson-2-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "./gradlew bootJar",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " creates the executable JAR under "
        ],
        [
          "build/libs",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "maven-gradle-lesson-2-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "bootJar",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " alone does not mean that tests ran."
        ]
      ]
    },
    {
      "id": "maven-gradle-lesson-2-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "The Windows wrapper is "
        ],
        [
          "gradlew.bat",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "maven-gradle-lesson-2-note-5",
      "type": "bulleted_list",
      "richText": [
        [
          "The rest of the notes use Maven commands. Gradle is an alternative build path, not a second required setup."
        ]
      ]
    },
    {
      "id": "maven-gradle-lesson-3",
      "type": "header",
      "richText": [
        [
          "Resolved dependencies"
        ]
      ]
    },
    {
      "id": "maven-gradle-lesson-3-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "./mvnw dependency:tree",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " lists the libraries Maven resolved and which dependency introduced each one."
        ]
      ]
    },
    {
      "id": "maven-gradle-lesson-3-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "This list helps explain why a Spring class is present or missing."
        ]
      ]
    },
    {
      "id": "maven-gradle-lesson-3-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "For Gradle, "
        ],
        [
          "./gradlew dependencies",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " provides the dependency report."
        ]
      ]
    }
  ],
