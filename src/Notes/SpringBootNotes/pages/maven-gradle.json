      "children": [
        {
          "id": "20924eb1-ed54-8083-80a5-c660b50d9052",
          "type": "text",
          "richText": [
            [
              "One builds the jar and installs it to the local repository; the other directly runs the app using source code."
            ]
          ]
        }
      ]
