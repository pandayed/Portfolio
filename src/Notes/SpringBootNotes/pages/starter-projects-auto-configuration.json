      "type": "bulleted_list",
      "richText": [
        [
          "Blindly relying on auto-configuration without knowing what’s happening."
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-8001-b213-ede313a2bedd",
      "type": "bulleted_list",
      "richText": [
        [
          "Including conflicting starters (e.g., multiple database starters)."
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-8051-8e11-d769e9bffff9",
      "type": "bulleted_list",
      "richText": [
        [
          "Not understanding the default behavior of the auto-configured components."
        ]
      ]
    },
