    {
      "id": "test-choose",
      "type": "header",
      "richText": [
        [
          "What a test checks"
        ]
      ]
    },
    {
      "id": "test-choose-b0",
      "type": "bulleted_list",
      "richText": [
        [
          "A test runs code with known input and checks the result against the expected behavior."
        ]
      ]
    },
    {
      "id": "test-choose-b1",
      "type": "bulleted_list",
      "richText": [
        [
          "An assertion is the check that makes the test pass or fail."
        ]
      ]
    },
    {
      "id": "test-choose-b2",
      "type": "bulleted_list",
      "richText": [
        [
          "A unit test checks a small part of the application in isolation, usually one class."
        ]
      ]
    },
    {
      "id": "test-choose-b3",
      "type": "bulleted_list",
      "richText": [
        [
          "An integration test checks components working together. It may load Spring or use a real database."
        ]
      ]
    },
    {
