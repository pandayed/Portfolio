    {
      "id": "test-scope-limits-b0",
      "type": "bulleted_list",
      "richText": [
        [
          "A mock supplies a chosen response. It cannot prove a real database query or external API works."
        ]
      ]
    },
    {
      "id": "test-scope-limits-b1",
      "type": "bulleted_list",
      "richText": [
        [
          "A test that only loads the context checks startup. It does not check application behavior."
        ]
      ]
    },
    {
      "id": "test-scope-limits-b2",
      "type": "bulleted_list",
      "richText": [
        [
          "Keep input and external dependencies controlled so tests can run independently."
        ]
      ]
    },
