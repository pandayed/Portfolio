  "blocks": [
    {
      "id": "quality-tools",
      "type": "header",
      "richText": [
        [
          "Static analysis"
        ]
      ]
    },
    {
      "id": "quality-tools-b0",
      "type": "bulleted_list",
      "richText": [
        [
          "Static analysis examines source code without running the application."
        ]
      ]
    },
    {
      "id": "quality-tools-b1",
      "type": "bulleted_list",
      "richText": [
        [
          "It reports patterns such as duplicated code, possible bugs and maintainability issues."
        ]
      ]
    },
    {
      "id": "quality-tools-table",
      "type": "table",
      "columnOrder": [
        "0",
        "1"
      ],
      "hasColumnHeader": true,
      "children": [
