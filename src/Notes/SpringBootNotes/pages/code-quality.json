          "id": "quality-tools-table-0",
          "type": "table_row",
          "cells": {
            "0": [
              [
                "Tool"
              ]
            ],
            "1": [
              [
                "Purpose"
              ]
            ]
          }
        },
        {
          "id": "quality-tools-table-1",
          "type": "table_row",
          "cells": {
            "0": [
              [
                "SonarQube for IDE"
              ]
            ],
            "1": [
              [
                "Reports issues while editing. Formerly named SonarLint."
              ]
            ]
          }
        },
        {
          "id": "quality-tools-table-2",
          "type": "table_row",
          "cells": {
            "0": [
              [
                "SonarQube Server"
              ]
            ],
            "1": [
              [
                "Stores project analysis on a server you operate."
              ]
            ]
          }
        },
        {
          "id": "quality-tools-table-3",
          "type": "table_row",
          "cells": {
            "0": [
              [
                "SonarQube Cloud"
              ]
            ],
            "1": [
              [
                "Provides hosted project analysis. Formerly named SonarCloud."
              ]
            ]
          }
        },
        {
          "id": "quality-tools-table-4",
          "type": "table_row",
          "cells": {
            "0": [
              [
                "Scanner"
              ]
            ],
            "1": [
              [
                "Analyzes a project revision and sends its results to Server or Cloud."
              ]
            ]
          }
        }
      ]
    },
    {
      "id": "quality-connected-b0",
      "type": "bulleted_list",
      "richText": [
        [
          "Connected mode aligns supported IDE rules and settings with a SonarQube project."
        ]
      ]
    },
    {
      "id": "quality-connected-b1",
      "type": "bulleted_list",
      "richText": [
        [
          "The Maven scanner integrates project analysis with a Java build."
        ]
      ]
    },
    {
      "id": "quality-gates",
      "type": "header",
      "richText": [
        [
          "Quality gates"
        ]
      ]
    },
    {
      "id": "quality-gates-b0",
      "type": "bulleted_list",
      "richText": [
        [
          "A quality gate checks configured conditions against the analysis results."
        ]
      ]
    },
    {
      "id": "quality-gates-b1",
      "type": "bulleted_list",
      "richText": [
        [
          "Conditions can cover issues, duplication and test coverage on new code."
        ]
      ]
    },
    {
      "id": "quality-gates-b2",
      "type": "bulleted_list",
      "richText": [
        [
          "A passing gate means those conditions passed. It does not mean every application behavior works."
        ]
      ]
    },
    {
      "id": "quality-gates-b3",
      "type": "bulleted_list",
      "richText": [
        [
          "When a release depends on the gate, configure CI to wait for its result. A completed upload is not the gate result."
        ]
      ]
    },
    {
      "id": "quality-coverage",
      "type": "header",
      "richText": [
        [
          "Test coverage"
        ]
      ]
    },
    {
      "id": "quality-coverage-b0",
      "type": "bulleted_list",
      "richText": [
        [
          "Coverage measures which code ran during test execution."
        ]
      ]
    },
    {
      "id": "quality-coverage-b1",
      "type": "bulleted_list",
      "richText": [
        [
          "A tool such as JaCoCo produces the coverage report. SonarQube imports that report."
        ]
      ]
    },
    {
      "id": "quality-coverage-b2",
      "type": "bulleted_list",
      "richText": [
        [
          "SonarQube does not run the tests to generate coverage."
        ]
      ]
    },
    {
      "id": "quality-coverage-b3",
      "type": "bulleted_list",
      "richText": [
        [
          "High coverage can still have weak assertions. Check meaningful results as well as execution."
        ]
      ]
    },
    {
      "id": "quality-workflow",
      "type": "header",
      "richText": [
        [
          "Project analysis in CI"
        ]
      ]
    },
    {
      "id": "quality-workflow-b0",
      "type": "bulleted_list",
      "richText": [
        [
          "Analyze the same application revision being built and reviewed."
        ]
      ]
    },
    {
      "id": "quality-workflow-b1",
      "type": "bulleted_list",
      "richText": [
        [
          "Configure the project key, source paths and coverage-report path."
        ]
      ]
    },
    {
      "id": "quality-workflow-b2",
      "type": "bulleted_list",
      "richText": [
        [
          "Supply the analysis token through a CI secret."
        ]
      ]
    },
    {
      "id": "quality-workflow-b3",
      "type": "bulleted_list",
      "richText": [
        [
          "Review findings in their code context. Fix a real issue or record a justified suppression."
        ]
      ]
    },
    {
      "id": "quality-workflow-b4",
      "type": "bulleted_list",
      "richText": [
        [
          "Exclude generated code only when the project policy allows it. Do not exclude application code to hide a reported issue."
        ]
      ]
    }
  ]
}
