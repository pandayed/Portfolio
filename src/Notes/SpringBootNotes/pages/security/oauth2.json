{
  "id": "spring-boot-security-oauth2",
  "title": "OAuth2 and OpenID Connect",
  "summary": "Separate delegated API access from login identity.",
  "sourceUrl": "https://www.youtube.com/playlist?list=PLA3GkZPtsafacdBLdd3p1DyRd5FGfr3Ue",
  "updatedOn": "2026-10-14",
  "sources": [
    {
      "title": "Spring Security 6.5: OAuth2 login",
      "url": "https://docs.spring.io/spring-security/reference/6.5/servlet/oauth2/login/core.html"
    },
    {
      "title": "Google: OpenID Connect",
      "url": "https://developers.google.com/identity/openid-connect/openid-connect"
    }
  ],
  "blocks": [
    {
      "id": "oauth-concepts",
      "type": "header",
      "richText": [
        [
          "OAuth2 grants access"
        ]
      ]
    },
    {
      "id": "oauth-concepts-b0",
      "type": "bulleted_list",
      "richText": [
        [
          "OAuth2 lets an application request access to resources on behalf of a user."
        ]
      ]
    },
    {
      "id": "oauth-concepts-b1",
      "type": "bulleted_list",
      "richText": [
        [
          "The client is the application requesting access."
        ]
      ]
    },
    {
      "id": "oauth-concepts-b2",
      "type": "bulleted_list",
      "richText": [
        [
          "The authorization server obtains permission and issues an access token."
        ]
      ]
    },
    {
      "id": "oauth-concepts-b3",
      "type": "bulleted_list",
      "richText": [
        [
          "The resource server accepts the access token and serves the protected API."
        ]
      ]
    },
    {
      "id": "oauth-concepts-b4",
      "type": "bulleted_list",
      "richText": [
        [
          "A scope names the access requested or granted."
        ]
      ]
    },
    {
      "id": "oauth-concepts-b5",
      "type": "bulleted_list",
      "richText": [
        [
          "The application does not need the user’s password for the provider."
        ]
      ]
    },
    {
      "id": "oidc",
      "type": "header",
      "richText": [
        [
          "OpenID Connect adds login"
        ]
      ]
    },
    {
      "id": "oidc-b0",
      "type": "bulleted_list",
      "richText": [
        [
          "OpenID Connect (OIDC) adds user authentication to OAuth2."
        ]
      ]
    },
    {
      "id": "oidc-b1",
      "type": "bulleted_list",
      "richText": [
        [
          "The openid scope requests OIDC login."
        ]
      ]
    },
    {
      "id": "oidc-b2",
      "type": "bulleted_list",
      "richText": [
        [
          "An ID token describes the authenticated user for the client. An access token is used to call an API."
        ]
      ]
    },
    {
      "id": "oidc-b3",
      "type": "bulleted_list",
      "richText": [
        [
          "An ID token is not automatically an access token for your own API."
        ]
      ]
    },
    {
      "id": "oauth-chain",
      "type": "header",
      "richText": [
        [
          "Authorization-code flow"
        ]
      ]
    },
    {
      "id": "oauth-flow-b0",
      "type": "bulleted_list",
      "richText": [
        [
          "The client redirects the browser to the provider."
        ]
      ]
    },
    {
      "id": "oauth-flow-b1",
      "type": "bulleted_list",
      "richText": [
        [
          "The user signs in and grants the requested access when required."
        ]
      ]
    },
    {
      "id": "oauth-flow-b2",
      "type": "bulleted_list",
      "richText": [
        [
          "The provider redirects to the registered callback with an authorization code."
        ]
      ]
    },
    {
      "id": "oauth-flow-b3",
      "type": "bulleted_list",
      "richText": [
        [
          "The client exchanges that code for tokens."
        ]
      ]
    },
    {
      "id": "oauth-flow-b4",
      "type": "bulleted_list",
      "richText": [
        [
          "The client validates the login response before creating an application session."
        ]
      ]
    },
    {
      "id": "oauth-flow-b5",
      "type": "bulleted_list",
      "richText": [
        [
          "The state parameter ties the response to the original login attempt."
        ]
      ]
    },
    {
      "id": "oauth-approaches",
      "type": "header",
      "richText": [
        [
          "Choose the Spring configuration"
        ]
      ]
    },
    {
      "id": "oauth-approaches-table",
      "type": "table",
      "columnOrder": [
        "0",
        "1"
      ],
      "hasColumnHeader": true,
      "children": [
        {
          "id": "oauth-approaches-table-0",
          "type": "table_row",
          "cells": {
            "0": [
              [
                "Application need"
              ]
            ],
            "1": [
              [
                "Spring configuration"
              ]
            ]
          }
        },
        {
          "id": "oauth-approaches-table-1",
          "type": "table_row",
          "cells": {
            "0": [
              [
                "Browser login through an external provider"
              ]
            ],
            "1": [
              [
                "oauth2Login. The application can remember login with a server session."
              ]
            ]
          }
        },
        {
          "id": "oauth-approaches-table-2",
          "type": "table_row",
          "cells": {
            "0": [
              [
                "API that receives access tokens"
              ]
            ],
            "1": [
              [
                "oauth2ResourceServer. The API validates tokens on incoming requests."
              ]
            ]
          }
        }
      ]
    },
    {
      "id": "oauth-google-next",
