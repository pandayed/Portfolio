    {
      "id": "security-auth-account-storage",
      "type": "header",
      "richText": [
        [
          "Account storage and password hashes"
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-2-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "UserDetailsService",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " loads an account. It does not perform the password comparison."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-2-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "InMemoryUserDetailsManager",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " implements "
        ],
        [
          "UserDetailsService",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " with accounts held in application memory."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-2-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "A database-backed implementation loads the account through a repository and returns "
        ],
        [
          "UserDetails",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-2-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "PasswordEncoder.encode",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " produces the hash when a password is created or changed."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-2-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "A salted password hash can change each time "
        ],
        [
          "encode",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " runs. Password checks use "
        ],
        [
          "matches",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ", not equality between two new hashes."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-2-note-5",
      "type": "bulleted_list",
      "richText": [
        [
          "PasswordEncoderFactories.createDelegatingPasswordEncoder()",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " supplies an encoder that records the encoding identifier with the hash."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-2-note-6",
      "type": "bulleted_list",
      "richText": [
        [
          "A stored value beginning with "
        ],
        [
          "{bcrypt}",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " selects BCrypt when checking the password."
        ]
      ]
    },
    {
      "id": "permissions",
      "type": "header",
      "richText": [
        [
          "Roles and authorities"
        ]
      ]
    },
    {
      "id": "permissions-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "GrantedAuthority",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " represents a permission string attached to "
        ],
        [
          "Authentication",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "permissions-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "hasAuthority(\"employee:read\")",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " checks for that exact string."
        ]
      ]
    },
    {
      "id": "permissions-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "hasRole(\"ADMIN\")",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " checks for "
        ],
        [
          "ROLE_ADMIN",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "permissions-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "roles(\"ADMIN\")",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " on the "
        ],
        [
          "User",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " builder adds the "
        ],
        [
          "ROLE_",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " prefix."
        ]
      ]
    },
    {
      "id": "permissions-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "authorities(\"employee:read\")",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " stores the exact authority supplied."
        ]
      ]
    },
    {
      "id": "permissions-note-5",
      "type": "bulleted_list",
      "richText": [
        [
          "The application defines what its authority strings mean."
        ]
      ]
    },
    {
      "id": "request-rules",
      "type": "header",
      "richText": [
        [
          "Request permissions"
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-4-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "requestMatchers",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " selects requests inside "
        ],
        [
          "authorizeHttpRequests",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-4-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "Spring checks these rules in declaration order and uses the first matching rule."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-4-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "permitAll()",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " allows the request without requiring login."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-4-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "authenticated()",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " requires login but does not require a particular role."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-4-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "denyAll()",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " rejects requests that reach that rule."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-4-note-5",
      "type": "bulleted_list",
      "richText": [
        [
          "permitAll()",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " leaves the other security filters active. A public state-changing endpoint can still require a CSRF token."
        ]
      ]
    },
    {
      "id": "permissions-code",
      "type": "example",
      "example": {
        "title": "Define an account and ordered request permissions",
        "language": "java",
        "description": [
          "Each example is a separate project. All required application files appear in the tabs.",
          "The process environment supplies `DEMO_USER_PASSWORD` before startup.",
          "The account is held in memory for this learning example."
        ],
        "code": "",
        "explanation": [
          "The `UserDetailsService` bean replaces Boot's generated account.",
          "Spring connects this account loader and the `PasswordEncoder` to password authentication.",
          "`reader` receives the authority `ROLE_USER`.",
          "An anonymous request can reach an existing `/public/**` endpoint.",
          "After login, `reader` can reach `/employees/**`.",
          "`reader` cannot reach `/admin/**` because it lacks `ROLE_ADMIN`.",
          "Other application routes are denied by the final rule.",
          "The built-in login filters handle their own login requests.",
          "Changing the in-memory account does not persist account changes across restarts."
        ],
        "files": [
          {
            "name": "src/main/java/com/example/demo/SecurityConfig.java",
            "language": "java",
            "code": "package com.example.demo;\n\nimport org.springframework.beans.factory.annotation.Value;\nimport org.springframework.context.annotation.Bean;\nimport org.springframework.context.annotation.Configuration;\nimport org.springframework.security.config.Customizer;\nimport org.springframework.security.config.annotation.web.builders.HttpSecurity;\nimport org.springframework.security.core.userdetails.User;\nimport org.springframework.security.core.userdetails.UserDetailsService;\nimport org.springframework.security.crypto.factory.PasswordEncoderFactories;\nimport org.springframework.security.crypto.password.PasswordEncoder;\nimport org.springframework.security.provisioning.InMemoryUserDetailsManager;\nimport org.springframework.security.web.SecurityFilterChain;\n\n@Configuration\npublic class SecurityConfig {\n    @Bean\n    PasswordEncoder passwordEncoder() {\n        return PasswordEncoderFactories.createDelegatingPasswordEncoder();\n    }\n\n    @Bean\n    UserDetailsService users(\n            PasswordEncoder encoder,\n            @Value(\"${DEMO_USER_PASSWORD}\") String password) {\n        return new InMemoryUserDetailsManager(\n            User.withUsername(\"reader\")\n                .password(encoder.encode(password))\n                .roles(\"USER\")\n                .build());\n    }\n\n    @Bean\n    SecurityFilterChain security(HttpSecurity http) throws Exception {\n        return http\n            .authorizeHttpRequests(rules -> rules\n                .requestMatchers(\"/public/**\").permitAll()\n                .requestMatchers(\"/admin/**\").hasRole(\"ADMIN\")\n                .requestMatchers(\"/employees/**\").hasRole(\"USER\")\n                .anyRequest().denyAll())\n            .formLogin(Customizer.withDefaults())\n            .build();\n    }\n}\n"
          },
          {
            "name": "src/main/java/com/example/demo/PageController.java",
            "language": "java",
            "code": "package com.example.demo;\nimport org.springframework.web.bind.annotation.GetMapping;\nimport org.springframework.web.bind.annotation.PostMapping;\nimport org.springframework.web.bind.annotation.RestController;\n@RestController\npublic class PageController {\n    @GetMapping(\"/\") public String home() { return \"Home\"; }\n    @GetMapping(\"/public/info\") public String info() { return \"Public information\"; }\n    @GetMapping(\"/admin/report\") public String admin() { return \"Admin report\"; }\n    @GetMapping(\"/employees\") public String employees() { return \"Employee list\"; }\n    @PostMapping(\"/employees\") public String create() { return \"Employee created\"; }\n}\n"
          },
          {
            "name": "pom.xml",
            "language": "text",
            "code": "<project xmlns=\"http://maven.apache.org/POM/4.0.0\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n         xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd\">\n    <modelVersion>4.0.0</modelVersion>\n    <parent>\n        <groupId>org.springframework.boot</groupId>\n        <artifactId>spring-boot-starter-parent</artifactId>\n        <version>3.5.16</version>\n        <relativePath/>\n    </parent>\n    <groupId>com.example</groupId>\n    <artifactId>demo</artifactId>\n    <version>1.0.0</version>\n    <properties><java.version>17</java.version></properties>\n    <dependencies>\n        <dependency>\n            <groupId>org.springframework.boot</groupId>\n            <artifactId>spring-boot-starter-web</artifactId>\n        </dependency>\n        <dependency>\n            <groupId>org.springframework.boot</groupId>\n            <artifactId>spring-boot-starter-security</artifactId>\n        </dependency>\n    </dependencies>\n    <build>\n        <finalName>demo</finalName>\n        <plugins>\n            <plugin>\n                <groupId>org.springframework.boot</groupId>\n                <artifactId>spring-boot-maven-plugin</artifactId>\n            </plugin>\n        </plugins>\n    </build>\n\n</project>\n"
          },
          {
            "name": "src/main/java/com/example/demo/DemoApplication.java",
            "language": "java",
            "code": "package com.example.demo;\n\nimport org.springframework.boot.SpringApplication;\nimport org.springframework.boot.autoconfigure.SpringBootApplication;\n\n@SpringBootApplication\npublic class DemoApplication {\n    public static void main(String[] args) {\n        SpringApplication.run(DemoApplication.class, args);\n    }\n}\n"
          }
        ],
        "commands": "mvn spring-boot:run"
      }
    },
    {
      "id": "method-permissions",
      "type": "header",
      "richText": [
        [
          "Method permissions"
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-5-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "@EnableMethodSecurity",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " on a configuration class activates method-level permission checks."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-5-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "@PreAuthorize(\"hasRole('ADMIN')\")",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " on a service method checks the caller before that method runs."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-5-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "Spring applies the check through the bean's proxy."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-5-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "A call from another Spring bean through that proxy receives the check."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-5-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "A method calling another method on the same object bypasses the proxy check."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-5-note-5",
      "type": "bulleted_list",
      "richText": [
        [
          "Unannotated methods do not acquire a permission rule automatically."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-5-note-6",
      "type": "bulleted_list",
      "richText": [
        [
          "Request rules control access to endpoints. Method rules protect service operations reached through other callers."
        ]
      ]
    },
    {
      "id": "access-response",
      "type": "header",
      "richText": [
        [
          "Access failures"
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-6-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "For form login, an unauthenticated request normally redirects to the login page."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-6-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "An authenticated user who lacks a required authority normally receives "
        ],
        [
          "403",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-6-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "A bearer-token API normally returns "
        ],
        [
          "401",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " for missing or invalid authentication."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-6-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "An "
        ],
        [
          "AuthenticationEntryPoint",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " defines how Spring starts authentication or reports that it is needed."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-6-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "An "
        ],
        [
          "AccessDeniedHandler",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " defines the response when an authenticated caller lacks permission."
        ]
      ]
