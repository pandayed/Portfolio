    {
      "id": "security-authentication-authorization-lesson-1-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "It passes an authentication request to "
        ],
        [
          "AuthenticationManager",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-1-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "ProviderManager",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " is the usual "
        ],
        [
          "AuthenticationManager",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " implementation."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-1-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "It delegates the authentication request to an "
        ],
        [
          "AuthenticationProvider",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " that supports that request type."
        ]
      ]
    },
    {
