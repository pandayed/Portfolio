    {
      "id": "security-authentication-authorization-lesson-0-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "Authentication",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " represents an authentication request or an authenticated identity in Spring Security."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-0-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "Before a password check, it can hold the submitted username and credentials."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-0-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "After a successful password check, it holds the authenticated principal and authorities."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-0-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "The principal is the account represented by the login."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-0-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "SecurityContext",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " holds the current "
        ],
        [
          "Authentication",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-0-note-5",
      "type": "bulleted_list",
      "richText": [
        [
          "SecurityContextHolder",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " provides access to that context for the current execution thread."
        ]
      ]
    },
    {
      "id": "security-authentication-authorization-lesson-0-note-6",
      "type": "bulleted_list",
      "richText": [
        [
          "Spring MVC can supply "
        ],
        [
          "Authentication",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " as a controller method parameter."
