{
  "id": "spring-boot-security-jwt",
  "title": "JWT access tokens",
  "summary": "Understand the contents and checks of a signed JWT before configuring an API.",
  "sourceUrl": "https://www.youtube.com/playlist?list=PLA3GkZPtsafacdBLdd3p1DyRd5FGfr3Ue",
  "updatedOn": "2026-10-14",
  "sources": [
    {
      "title": "Engineering Digest: Complete JWT Authentication and Authorisation in Spring Boot",
      "url": "https://www.youtube.com/watch?v=qvAoUVXgpZg&list=PLA3GkZPtsafacdBLdd3p1DyRd5FGfr3Ue"
    },
    {
      "title": "Spring Security 6: JWT resource server",
      "url": "https://docs.spring.io/spring-security/reference/6.5/servlet/oauth2/resource-server/jwt.html"
    },
    {
      "title": "Spring Security 6: CSRF protection",
      "url": "https://docs.spring.io/spring-security/reference/6.5/servlet/exploits/csrf.html"
    },
    {
      "title": "JWT specification",
      "url": "https://www.rfc-editor.org/rfc/rfc7519"
    }
  ],
  "blocks": [
    {
      "id": "jwt-meaning",
      "type": "header",
      "richText": [
        [
          "A signed JWT carries claims"
        ]
      ]
    },
    {
      "id": "jwt-meaning-b0",
      "type": "bulleted_list",
      "richText": [
        [
          "JSON Web Token (JWT) is a token format."
        ]
      ]
    },
    {
      "id": "jwt-meaning-b1",
      "type": "bulleted_list",
      "richText": [
        [
          "A signed JWT has three parts: header, payload and signature."
        ]
      ]
    },
    {
      "id": "jwt-meaning-b2",
      "type": "bulleted_list",
      "richText": [
        [
          "The header names the signing algorithm. The payload contains claims, which are named values about the token."
        ]
      ]
    },
    {
      "id": "jwt-meaning-b3",
      "type": "bulleted_list",
      "richText": [
        [
          "The signature lets the receiver check whether the signed contents were changed and whether a trusted key signed them."
        ]
      ]
    },
    {
      "id": "jwt-meaning-b4",
      "type": "bulleted_list",
      "richText": [
        [
          "The payload of a signed JWT is encoded, not hidden. Do not put passwords or private application content in it."
        ]
      ]
    },
    {
      "id": "jwt-claims",
      "type": "header",
      "richText": [
        [
          "Claims used when checking access"
        ]
      ]
    },
    {
      "id": "jwt-claims-table",
      "type": "table",
      "columnOrder": [
        "0",
        "1"
      ],
      "hasColumnHeader": true,
      "children": [
        {
          "id": "jwt-claims-table-0",
          "type": "table_row",
          "cells": {
            "0": [
              [
                "Claim"
              ]
            ],
            "1": [
              [
                "Meaning"
              ]
            ]
          }
        },
        {
          "id": "jwt-claims-table-1",
          "type": "table_row",
          "cells": {
            "0": [
              [
                "iss"
              ]
            ],
            "1": [
              [
                "Issuer: who issued the token."
              ]
            ]
          }
        },
        {
          "id": "jwt-claims-table-2",
          "type": "table_row",
          "cells": {
            "0": [
              [
                "sub"
              ]
            ],
            "1": [
              [
                "Subject: the identity described by the token."
              ]
            ]
          }
        },
        {
          "id": "jwt-claims-table-3",
          "type": "table_row",
          "cells": {
            "0": [
              [
                "aud"
              ]
            ],
            "1": [
              [
                "Audience: the recipient the token is intended for."
              ]
            ]
          }
        },
        {
          "id": "jwt-claims-table-4",
          "type": "table_row",
          "cells": {
            "0": [
              [
                "exp"
              ]
            ],
            "1": [
              [
                "Expiration: the time after which the token must not be accepted."
              ]
            ]
          }
        },
        {
          "id": "jwt-claims-table-5",
          "type": "table_row",
          "cells": {
            "0": [
              [
                "nbf"
              ]
            ],
            "1": [
              [
                "Not before: the time before which the token must not be accepted."
              ]
            ]
          }
        }
      ]
    },
    {
      "id": "jwt-bearer",
      "type": "header",
      "richText": [
        [
          "Send an access token"
        ]
      ]
    },
    {
      "id": "jwt-bearer-b0",
      "type": "bulleted_list",
      "richText": [
        [
          "An authorization server issues access tokens."
        ]
      ]
    },
    {
      "id": "jwt-bearer-b1",
      "type": "bulleted_list",
      "richText": [
        [
          "A resource server is an API that accepts tokens and checks access to its resources."
        ]
      ]
    },
    {
      "id": "jwt-bearer-b2",
      "type": "bulleted_list",
      "richText": [
        [
          "A bearer token grants access to whoever holds it. Send it over HTTPS in the Authorization header with the Bearer prefix."
        ]
      ]
    },
    {
      "id": "jwt-bearer-b3",
      "type": "bulleted_list",
      "richText": [
        [
          "Do not put token values in URLs or logs."
        ]
      ]
    },
    {
      "id": "jwt-validation",
      "type": "header",
      "richText": [
        [
          "Validate before trusting claims"
        ]
      ]
    },
    {
      "id": "jwt-validation-b0",
      "type": "bulleted_list",
      "richText": [
        [
          "Check the signature using trusted keys and allowed signing algorithms."
        ]
      ]
    },
    {
      "id": "jwt-validation-b1",
      "type": "bulleted_list",
      "richText": [
        [
          "Check the expected issuer and audience. Check expiration and not-before time when present."
        ]
      ]
    },
    {
      "id": "jwt-validation-b2",
      "type": "bulleted_list",
      "richText": [
        [
          "Decoding the payload only reads its contents. It does not validate the token."
        ]
      ]
    },
    {
      "id": "jwt-validation-b3",
      "type": "bulleted_list",
      "richText": [
        [
          "After validation, apply the permissions required by the operation."
        ]
      ]
    },
    {
      "id": "jwt-lifecycle",
      "type": "header",
      "richText": [
        [
          "Expiration and revocation"
        ]
      ]
    },
    {
      "id": "jwt-lifecycle-b0",
      "type": "bulleted_list",
      "richText": [
        [
          "A stolen token can remain valid until it expires unless the application has a way to reject it sooner."
        ]
      ]
    },
    {
      "id": "jwt-lifecycle-b1",
      "type": "bulleted_list",
      "richText": [
        [
          "Use a defined expiration policy for access tokens."
        ]
      ]
    },
    {
      "id": "jwt-lifecycle-b2",
      "type": "bulleted_list",
      "richText": [
        [
          "A refresh token can obtain a new access token. It needs its own storage, expiration and revocation rules."
        ]
      ]
    },
    {
      "id": "jwt-lifecycle-b3",
      "type": "bulleted_list",
      "richText": [
        [
          "For centrally checked token validity, an API can use opaque tokens and introspection. Introspection asks the authorization server whether a token is still active."
        ]
      ]
    },
    {
      "id": "jwt-resource-next",
      "type": "bulleted_list",
      "richText": [
        [
          "Configure a JWT resource server",
          [
            [
              "a",
              "/notes/spring-boot/security/resource-server"
            ]
          ]
        ]
      ]
    }
  ]
}
