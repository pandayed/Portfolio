    },
    {
      "id": "application-properties-lesson-2",
      "type": "header",
      "richText": [
        [
          "Configuration changes"
        ]
      ]
    },
    {
      "id": "application-properties-lesson-2-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "Ordinary configuration binding happens during startup."
        ]
      ]
    },
    {
      "id": "application-properties-lesson-2-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "Editing a file does not automatically update existing bean fields."
        ]
      ]
    },
    {
      "id": "application-properties-lesson-2-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "A restart loads the changed values unless the application has separate refresh support."
        ]
      ]
    },
    {
      "id": "application-properties-lesson-2-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "Read configuration in Java explains how a bean receives custom settings."
        ]
      ]
    },
    {
      "id": "application-properties-lesson-2-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "Spring profiles follows that lesson and groups configuration for different runs."
        ]
      ]
    }
  ],
