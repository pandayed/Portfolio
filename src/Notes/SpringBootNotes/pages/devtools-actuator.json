    },
    {
      "id": "20824eb1-ed54-80a5-9069-cc0a7fef3f9a",
      "type": "text",
      "richText": [
        [
          "Step 1: Add Dependencies in ",
          [
            [
              "b"
            ]
          ]
        ],
        [
          "pom.xml",
          [
            [
              "b"
            ],
            [
              "c"
            ]
          ]
        ],
        [
          " (for Maven)",
          [
            [
              "b"
            ]
          ]
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-80e3-9e01-e9bda203cc22",
      "type": "code",
      "richText": [
        [
          "<dependencies>\n    <!-- Spring Boot Starter Web -->\n    <dependency>\n        <groupId>org.springframework.boot</groupId>\n        <artifactId>spring-boot-starter-web</artifactId>\n    </dependency>\n\n    <!-- DevTools for Development -->\n    <dependency>\n        <groupId>org.springframework.boot</groupId>\n        <artifactId>spring-boot-devtools</artifactId>\n        <scope>runtime</scope>\n        <optional>true</optional>\n    </dependency>\n\n    <!-- Actuator for Monitoring -->\n    <dependency>\n        <groupId>org.springframework.boot</groupId>\n        <artifactId>spring-boot-starter-actuator</artifactId>\n    </dependency>\n</dependencies>\n"
        ]
      ],
      "language": "XML"
    },
    {
      "id": "20824eb1-ed54-8008-987c-fd7a36112f0d",
      "type": "text",
      "richText": [
        [
          "Step 2: Add Config in ",
          [
            [
              "b"
            ]
          ]
        ],
        [
          "application.properties",
          [
            [
              "b"
            ],
            [
              "c"
            ]
          ]
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-802e-be30-f67983df1a83",
      "type": "code",
      "richText": [
        [
          "# Enable selected Actuator endpoints\nmanagement.endpoints.web.exposure.include=health,info\n\n# Optional: Enable live reload if using browser plugin\nspring.devtools.livereload.enabled=true\n"
        ]
      ],
      "language": "Plain Text"
    },
