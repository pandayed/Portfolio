    {
      "id": "http-methods-lesson-1",
      "type": "header",
      "richText": [
        [
          "One path with two handlers"
        ]
      ]
    },
    {
      "id": "http-methods-lesson-1-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "@RequestMapping",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " can declare a method explicitly, such as "
        ],
        [
          "method = RequestMethod.POST",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "http-methods-lesson-1-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "The shorter "
        ],
        [
          "@PostMapping",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " expresses the same method restriction."
        ]
      ]
    },
    {
      "id": "http-methods-lesson-1-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "@RequestMapping",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " without a method restriction can match multiple HTTP methods."
        ]
      ]
    },
    {
      "id": "http-methods-lesson-1-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "Separate mapping annotations do not belong on the same method. Each handler declares one mapping."
        ]
      ]
    },
    {
      "id": "http-methods-lesson-1-example-0",
      "type": "example",
      "example": {
        "title": "Handle `GET` and `POST` at the same path",
        "language": "java",
        "description": [
          "Each example is a separate project. All required application files appear in the tabs.",
          "The example demonstrates method selection. It does not store greetings.",
          "The commands run after the application restarts and assume port `8080`.",
          "`mvn spring-boot:run` starts the application from the directory containing `pom.xml`. Requests run in a second terminal."
        ],
        "code": "",
        "explanation": [
          "Both methods inherit the class path `/greetings`.",
          "`GET /greetings` calls `readGreeting()`.",
          "`POST /greetings` calls `generateGreeting()`.",
          "The Java method name does not select the HTTP method. The mapping annotation does.",
          "Request and response bodies explains how a `POST` handler receives JSON later."
        ],
        "commands": "curl http://localhost:8080/greetings\ncurl -X POST http://localhost:8080/greetings",
        "result": "Hello\nA greeting generated for this request",
        "files": [
          {
            "name": "src/main/java/com/example/demo/GreetingController.java",
            "language": "java",
            "code": "package com.example.demo;\n\nimport org.springframework.web.bind.annotation.GetMapping;\nimport org.springframework.web.bind.annotation.PostMapping;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.RestController;\n\n@RestController\n@RequestMapping(\"/greetings\")\npublic class GreetingController {\n    @GetMapping\n    public String readGreeting() {\n        return \"Hello\";\n    }\n\n    @PostMapping\n    public String generateGreeting() {\n        return \"A greeting generated for this request\";\n    }\n}\n"
          },
          {
            "name": "pom.xml",
            "language": "text",
            "code": "<project xmlns=\"http://maven.apache.org/POM/4.0.0\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n         xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd\">\n    <modelVersion>4.0.0</modelVersion>\n    <parent>\n        <groupId>org.springframework.boot</groupId>\n        <artifactId>spring-boot-starter-parent</artifactId>\n        <version>3.5.16</version>\n        <relativePath/>\n    </parent>\n    <groupId>com.example</groupId>\n    <artifactId>demo</artifactId>\n    <version>1.0.0</version>\n    <properties><java.version>17</java.version></properties>\n    <dependencies>\n        <dependency>\n            <groupId>org.springframework.boot</groupId>\n            <artifactId>spring-boot-starter-web</artifactId>\n        </dependency>\n    </dependencies>\n    <build>\n        <finalName>demo</finalName>\n        <plugins>\n            <plugin>\n                <groupId>org.springframework.boot</groupId>\n                <artifactId>spring-boot-maven-plugin</artifactId>\n            </plugin>\n        </plugins>\n    </build>\n\n</project>\n"
          },
          {
            "name": "src/main/java/com/example/demo/DemoApplication.java",
            "language": "java",
            "code": "package com.example.demo;\n\nimport org.springframework.boot.SpringApplication;\nimport org.springframework.boot.autoconfigure.SpringBootApplication;\n\n@SpringBootApplication\npublic class DemoApplication {\n    public static void main(String[] args) {\n        SpringApplication.run(DemoApplication.class, args);\n    }\n}\n"
          }
        ]
      }
    },
    {
      "id": "http-methods-lesson-2",
      "type": "header",
      "richText": [
        [
          "Mapping outcomes"
        ]
      ]
    },
    {
      "id": "http-methods-lesson-2-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "A request using an unsupported method for a mapped path normally receives "
        ],
        [
          "405 Method Not Allowed",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "http-methods-lesson-2-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "Two handler methods with the same mapping can cause an ambiguous-mapping error at startup."
        ]
      ]
    },
    {
      "id": "http-methods-lesson-2-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "Spring MVC normally supports "
        ],
        [
          "HEAD",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " through an existing "
        ],
        [
          "GET",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " mapping."
        ]
      ]
    },
    {
      "id": "http-methods-lesson-2-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "Spring MVC can answer "
        ],
        [
          "OPTIONS",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " with an "
        ],
        [
          "Allow",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " header based on the registered mappings."
        ]
      ]
    },
    {
      "id": "http-methods-lesson-2-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "These mapping features do not enforce the intended data changes or idempotency of application code."
        ]
      ]
    }
  ],
  "summary": "Select handlers by HTTP method without confusing mapping annotations with application operations.",
