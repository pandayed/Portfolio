      "id": "http-methods-lesson-0",
      "type": "header",
      "richText": [
        [
          "Method-specific mappings"
        ]
      ]
    },
    {
      "id": "http-methods-lesson-0-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "Spring MVC uses both the path and the HTTP method to choose a handler."
        ]
      ]
    },
    {
      "id": "http-methods-lesson-0-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "Different handlers can use the same path when their HTTP methods differ."
        ]
      ]
    },
    {
      "id": "http-methods-lesson-0-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "The mapping annotation selects a handler. Its Java code performs the operation."
        ]
      ]
    },
    {
      "id": "http-methods-lesson-0-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "@PostMapping",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " does not save data automatically."
        ]
      ]
    },
    {
      "id": "http-methods-lesson-0-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "@PutMapping",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ", "
        ],
        [
          "@PatchMapping",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ", and "
        ],
        [
          "@DeleteMapping",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " do not implement replacement, partial updates, or deletion automatically."
        ]
      ]
    },
