      "type": "numbered_list",
      "richText": [
        [
          "Can you explain what happens behind the scenes when a client calls a "
        ],
        [
          "@GetMapping",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " endpoint?"
        ]
      ]
