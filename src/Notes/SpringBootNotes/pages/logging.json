      "type": "code",
      "richText": [
        [
          "# Set log level for root\nlogging.level.root=INFO\n\n# Save logs to a file\nlogging.file.name=app.log\nlogging.pattern.console=%d{yyyy-MM-dd HH:mm:ss} - %msg%n\n"
        ]
      ],
      "language": "Plain Text"
