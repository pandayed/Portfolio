    {
      "id": "logging-lesson-2",
      "type": "header",
      "richText": [
        [
          "A logger in an application class"
        ]
      ]
    },
    {
      "id": "logging-lesson-2-example-0",
      "type": "example",
      "example": {
        "title": "Log a greeting request",
        "language": "java",
        "description": [
          "Java `17` and Maven are required. The files form a separate project rooted at `pom.xml`.",
          "`GreetingRunner` invokes `greet(\"Lal\")` after startup."
        ],
        "code": "",
        "explanation": [
          "`LoggerFactory.getLogger(GreetingService.class)` creates a logger named for this class.",
          "`log.debug` submits a `DEBUG` message. The package setting allows it to appear.",
          "`{}` marks where SLF4J inserts the supplied value.",
          "The message contains `Building greeting for Lal`. Spring Boot also adds metadata such as time and logger name.",
          "The method returns `Hello, Lal`. Logging does not change the return value."
        ],
        "commands": "mvn spring-boot:run",
        "files": [
          {
            "name": "src/main/java/com/example/demo/GreetingService.java",
            "language": "java",
            "code": "package com.example.demo;\n\nimport org.slf4j.Logger;\nimport org.slf4j.LoggerFactory;\nimport org.springframework.stereotype.Service;\n\n@Service\npublic class GreetingService {\n    private static final Logger log =\n            LoggerFactory.getLogger(GreetingService.class);\n\n    public String greet(String name) {\n        log.debug(\"Building greeting for {}\", name);\n        return \"Hello, \" + name;\n    }\n}\n"
          },
          {
            "name": "src/main/java/com/example/demo/DemoApplication.java",
            "language": "java",
            "code": "package com.example.demo;\n\nimport org.springframework.boot.SpringApplication;\nimport org.springframework.boot.autoconfigure.SpringBootApplication;\n\n@SpringBootApplication\npublic class DemoApplication {\n    public static void main(String[] args) {\n        SpringApplication.run(DemoApplication.class, args);\n    }\n}\n"
          },
          {
            "name": "pom.xml",
            "language": "text",
            "code": "<project xmlns=\"http://maven.apache.org/POM/4.0.0\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n         xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd\">\n    <modelVersion>4.0.0</modelVersion>\n    <parent>\n        <groupId>org.springframework.boot</groupId>\n        <artifactId>spring-boot-starter-parent</artifactId>\n        <version>3.5.16</version>\n        <relativePath/>\n    </parent>\n    <groupId>com.example</groupId>\n    <artifactId>demo</artifactId>\n    <version>1.0.0</version>\n    <properties><java.version>17</java.version></properties>\n    <dependencies>\n        <dependency>\n            <groupId>org.springframework.boot</groupId>\n            <artifactId>spring-boot-starter-web</artifactId>\n        </dependency>\n    </dependencies>\n    <build>\n        <finalName>demo</finalName>\n        <plugins>\n            <plugin>\n                <groupId>org.springframework.boot</groupId>\n                <artifactId>spring-boot-maven-plugin</artifactId>\n            </plugin>\n        </plugins>\n    </build>\n\n</project>\n"
          },
          {
            "name": "src/main/resources/application.properties",
            "language": "text",
            "code": "logging.level.com.example.demo=DEBUG\n"
          },
          {
            "name": "src/main/java/com/example/demo/GreetingRunner.java",
            "language": "java",
            "code": "package com.example.demo;\nimport org.springframework.boot.CommandLineRunner;\nimport org.springframework.stereotype.Component;\n@Component\npublic class GreetingRunner implements CommandLineRunner {\n    private final GreetingService service;\n    public GreetingRunner(GreetingService service) { this.service = service; }\n    public void run(String... args) { service.greet(\"Lal\"); }\n}\n"
          }
        ]
      }
    },
    {
      "id": "logging-lesson-3",
      "type": "header",
      "richText": [
        [
          "Files and diagnostic details"
        ]
      ]
    },
    {
      "id": "logging-lesson-3-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "logging.file.name=logs/application.log",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " writes to that file as well as the console. A relative path starts from the process working directory."
        ]
      ]
    },
    {
      "id": "logging-lesson-3-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "logging.pattern.console",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " changes the console format."
        ]
      ]
    },
    {
      "id": "logging-lesson-3-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "logback-spring.xml",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " configures Logback features beyond these properties. An appender is the Logback component that writes to a destination."
        ]
      ]
    },
    {
      "id": "logging-lesson-3-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "A throwable passed as the last logging argument adds its stack trace. Logging it does not throw it again."
        ]
      ]
    },
    {
      "id": "logging-lesson-3-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "A correlation ID is a value included in related log messages. It helps connect events from one request."
        ]
      ]
    },
    {
      "id": "logging-lesson-3-note-5",
      "type": "bulleted_list",
      "richText": [
        [
          "Passwords, access tokens, and private request bodies do not belong in log messages."
        ]
      ]
    },
    {
      "id": "logging-lesson-3-note-6",
      "type": "bulleted_list",
      "richText": [
        [
          "The Actuator lesson later covers runtime inspection. Its "
        ],
        [
          "loggers",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " endpoint can also change levels while the application runs."
        ]
      ]
    }
