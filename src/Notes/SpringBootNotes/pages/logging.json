  "blocks": [
    {
      "id": "logging-lesson-0",
      "type": "header",
      "richText": [
        [
          "Spring Boot logging"
        ]
      ]
    },
    {
      "id": "logging-lesson-0-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "Spring Boot configures a logging implementation during startup. The standard starters use Logback."
        ]
      ]
    },
    {
      "id": "logging-lesson-0-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "Application code can call SLF4J, the Java logging API that Logback implements."
        ]
      ]
    },
    {
      "id": "logging-lesson-0-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "A logger identifies the class or package that wrote a message. Spring Boot includes this name in its default log format."
        ]
      ]
    },
    {
      "id": "logging-lesson-0-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "Logs go to the console by default. "
        ],
        [
          "logging.file.name",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " adds a file destination."
        ]
      ]
    },
    {
      "id": "logging-lesson-1",
      "type": "header",
      "richText": [
        [
          "Log levels"
        ]
      ]
    },
    {
      "id": "logging-lesson-1-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "A configured level sets the lowest severity that a logger writes."
        ]
      ]
    },
    {
      "id": "logging-lesson-1-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "logging.level.root=INFO",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " allows "
        ],
        [
          "INFO",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ", "
        ],
        [
          "WARN",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ", and "
        ],
        [
          "ERROR",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ". It filters out "
        ],
        [
          "DEBUG",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " and "
        ],
        [
          "TRACE",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "logging-lesson-1-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "logging.level.com.example.demo=DEBUG",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " gives that package more detail without changing every logger."
        ]
      ]
    },
