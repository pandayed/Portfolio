    {
      "id": "20924eb1-ed54-803b-baff-c6c09a028b8b",
      "type": "sub_sub_header",
      "richText": [
        [
          "Simple logging in a Spring Boot application:"
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-809a-94ec-c01b6b90628f",
      "type": "code",
      "richText": [
        [
          "import org.slf4j.Logger;\nimport org.slf4j.LoggerFactory;\nimport org.springframework.boot.CommandLineRunner;\nimport org.springframework.boot.SpringApplication;\nimport org.springframework.boot.autoconfigure.SpringBootApplication;\n\n@SpringBootApplication\npublic class LoggingDemoApplication implements CommandLineRunner {\n\n    // Create a logger for this class\n    private static final Logger logger = LoggerFactory.getLogger(LoggingDemoApplication.class);\n\n    public static void main(String[] args) {\n        SpringApplication.run(LoggingDemoApplication.class, args);\n    }\n\n    @Override\n    public void run(String... args) {\n        logger.info(\"Application started successfully.\");\n        logger.debug(\"Debugging application startup.\");\n        logger.warn(\"This is a warning message.\");\n        logger.error(\"This is an error message.\");\n    }\n}\n"
        ]
      ],
      "language": "Java"
    },
    {
      "id": "20924eb1-ed54-8062-8552-ffffd281504d",
      "type": "sub_sub_header",
      "richText": [
        [
          "application.properties",
          [
            [
              "c"
            ]
          ]
        ],
