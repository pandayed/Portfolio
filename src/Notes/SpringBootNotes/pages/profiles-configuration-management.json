        [
          "✅ 1. Core Concept (2–3 sentences)"
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-8053-92b4-cda845e2221a",
      "type": "text",
      "richText": [
        [
          "Spring Boot Profiles",
          [
            [
              "b"
            ]
          ]
        ],
        [
          " allow you to separate configuration settings for different environments like "
        ],
        [
          "development",
          [
            [
              "b"
            ]
          ]
        ],
        [
          ", "
        ],
        [
          "testing",
          [
            [
              "b"
            ]
          ]
        ],
        [
          ", or "
        ],
        [
          "production",
          [
            [
              "b"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-8084-8628-f55d854f183b",
      "type": "text",
      "richText": [
        [
          "Configuration Management",
          [
            [
              "b"
            ]
          ]
        ],
        [
          " using annotations like "
        ],
        [
          "@Value",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " and "
        ],
        [
          "@ConfigurationProperties",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " helps you "
        ],
        [
          "inject values from external sources",
          [
            [
              "b"
            ]
          ]
        ],
        [
          " (like "
        ],
        [
          "application.properties",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ") into your Java code, making your application "
        ],
        [
          "easier to configure, reuse, and deploy",
          [
            [
              "b"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-8042-9f1c-f54fcb6511f6",
      "type": "divider"
    },
    {
      "id": "20924eb1-ed54-804c-8d62-dfc1000c5d16",
      "type": "sub_header",
      "richText": [
        [
          "🎯 2. Key Interview Points"
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-80e0-a957-f8ddec787868",
      "type": "bulleted_list",
      "richText": [
        [
          "✅ "
        ],
        [
          "What are Spring Profiles?",
          [
            [
              "b"
            ]
          ]
        ]
      ],
      "children": [
        {
          "id": "20924eb1-ed54-802d-a664-d192df75f0a9",
          "type": "text",
          "richText": [
            [
              "Profiles allow your application to load different configurations based on the environment it's running in (e.g., dev, test, prod)."
            ]
          ]
        }
      ]
    },
    {
      "id": "20924eb1-ed54-8086-9359-d890f7e3bd0b",
      "type": "bulleted_list",
      "richText": [
        [
          "✅ "
        ],
        [
          "How does Spring Boot load configuration?",
          [
            [
              "b"
            ]
          ]
        ]
      ],
      "children": [
        {
          "id": "20924eb1-ed54-8048-82dd-d8c60dbf79e8",
          "type": "text",
          "richText": [
            [
              "Spring Boot automatically reads from "
            ],
            [
              "application.properties",
              [
                [
                  "c"
                ]
              ]
            ],
            [
              " or "
            ],
            [
              "application.yml",
              [
                [
                  "c"
                ]
              ]
            ],
            [
              " and can load profile-specific versions like "
            ],
            [
              "application-dev.properties",
              [
                [
                  "c"
                ]
              ]
            ],
            [
              "."
            ]
          ]
        }
      ]
    },
    {
      "id": "20924eb1-ed54-806c-a2f1-db40ac8a7968",
      "type": "bulleted_list",
      "richText": [
        [
          "✅ "
        ],
        [
          "What is ",
          [
            [
              "b"
            ]
          ]
        ],
        [
          "@Value",
          [
            [
              "b"
            ],
            [
              "c"
            ]
          ]
        ],
        [
          " and how does it work?",
          [
            [
              "b"
            ]
          ]
        ]
      ],
      "children": [
        {
          "id": "20924eb1-ed54-8082-93f0-c5a21d6cba57",
          "type": "text",
          "richText": [
            [
              "@Value",
              [
                [
                  "c"
                ]
              ]
            ],
            [
              " is used to inject a "
            ],
            [
              "single",
              [
                [
                  "b"
                ]
              ]
            ],
            [
              " configuration value (like a string or number) into a field from the properties file."
            ]
          ]
        }
      ]
    },
    {
      "id": "20924eb1-ed54-8000-857e-d824218e0e3d",
      "type": "bulleted_list",
      "richText": [
        [
          "✅ "
        ],
        [
          "What is ",
          [
            [
              "b"
            ]
          ]
        ],
        [
          "@ConfigurationProperties",
          [
            [
              "b"
            ],
            [
              "c"
            ]
          ]
        ],
        [
          " and when to use it?",
          [
            [
              "b"
            ]
          ]
        ]
      ],
      "children": [
        {
          "id": "20924eb1-ed54-80db-ab02-f76b2da2a107",
          "type": "text",
          "richText": [
            [
              "Use "
            ],
            [
              "@ConfigurationProperties",
              [
                [
                  "c"
                ]
              ]
            ],
            [
              " when you need to "
            ],
            [
              "bind a group of related configuration values",
              [
                [
                  "b"
                ]
              ]
            ],
            [
              " into a Java class (e.g., database settings, external API details)."
            ]
          ]
        }
      ]
    },
    {
      "id": "20924eb1-ed54-80c8-8762-cd119dedf25f",
      "type": "divider"
    },
    {
      "id": "20924eb1-ed54-80f1-a8b8-ff25c155efe7",
      "type": "sub_header",
      "richText": [
        [
          "👨‍💻 3. Code Example"
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-803f-a0dd-c7d5d187d7a6",
      "type": "text",
      "richText": [
        [
          "Let’s walk through a real-world example: managing database configuration using profiles."
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-804d-aa68-e99fc413a34c",
      "type": "sub_sub_header",
      "richText": [
        [
          "Step 1: Define different property files"
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-809a-a76d-ff932ac26f48",
      "type": "text",
      "richText": [
        [
          "application.properties",
          [
            [
              "b"
            ],
            [
              "c"
            ]
          ]
        ],
        [
          " (default file):"
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-80e3-95bb-c8f56cf7750b",
      "type": "code",
      "richText": [
        [
          "spring.profiles.active=dev\n"
        ]
      ],
      "language": "Plain Text"
    },
    {
      "id": "20924eb1-ed54-8047-be77-ea66559c321a",
      "type": "text",
      "richText": [
        [
          "application-dev.properties",
          [
            [
              "b"
            ],
            [
              "c"
            ]
          ]
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-805e-afde-dc407d5c3527",
      "type": "code",
      "richText": [
        [
          "app.name=MyApp-Dev\ndb.url=jdbc:mysql://localhost:3306/devdb\ndb.user=devuser\ndb.pass=devpass\n"
        ]
      ],
      "language": "Plain Text"
    },
    {
      "id": "20924eb1-ed54-80db-91e7-da72283dabc5",
      "type": "text",
      "richText": [
        [
          "application-prod.properties",
          [
            [
              "b"
            ],
            [
              "c"
            ]
          ]
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-8011-bc1a-fc9f75d84458",
      "type": "code",
      "richText": [
        [
          "app.name=MyApp-Prod\ndb.url=jdbc:mysql://prodserver:3306/proddb\ndb.user=produser\ndb.pass=prodpass\n"
        ]
      ],
      "language": "Plain Text"
    },
    {
      "id": "20924eb1-ed54-80ca-bb0d-f6bc78f676fa",
      "type": "sub_sub_header",
      "richText": [
        [
          "Step 2: Inject config using "
        ],
        [
          "@ConfigurationProperties",
          [
            [
              "c"
            ]
          ]
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-80b7-855b-e50e5717d6ad",
      "type": "code",
      "richText": [
        [
          "// AppConfig.java\nimport org.springframework.boot.context.properties.ConfigurationProperties;\nimport org.springframework.context.annotation.Configuration;\n\n@Configuration\n@ConfigurationProperties(prefix = \"db\")\npublic class AppConfig {\n    private String url;\n    private String user;\n    private String pass;\n\n    // Getters and Setters\n    public String getUrl() { return url; }\n    public void setUrl(String url) { this.url = url; }\n\n    public String getUser() { return user; }\n    public void setUser(String user) { this.user = user; }\n\n    public String getPass() { return pass; }\n    public void setPass(String pass) { this.pass = pass; }\n}\n"
        ]
      ],
      "language": "Java"
    },
    {
      "id": "20924eb1-ed54-80a6-b30f-ef8208e62427",
      "type": "sub_sub_header",
      "richText": [
        [
          "Step 3: Use it in a service"
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-8090-9c85-e0f37008078b",
      "type": "code",
      "richText": [
        [
          "// MyService.java\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.stereotype.Service;\n\n@Service\npublic class MyService {\n\n    @Autowired\n    private AppConfig config;\n\n    public void connect() {\n        System.out.println(\"Connecting to: \" + config.getUrl());\n    }\n}\n"
        ]
      ],
      "language": "Java"
    },
    {
      "id": "20924eb1-ed54-8078-af84-d863683e73e2",
      "type": "sub_sub_header",
      "richText": [
        [
          "Alternative: Use "
        ],
        [
          "@Value",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " for single values"
        ]
      ]
    },
    {
      "id": "20924eb1-ed54-80a3-b032-f2c855e60da2",
      "type": "code",
      "richText": [
        [
          "@Value(\"${app.name}\")\nprivate String appName;\n"
        ]
      ],
      "language": "Java"
    },
    {
      "id": "20924eb1-ed54-805c-82cb-d485788cfae1",
      "type": "divider"
    },
    {
      "id": "20924eb1-ed54-8056-82de-d167041ac42c",
