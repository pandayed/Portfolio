    {
      "id": "testing-spring-boot-lesson-2",
      "type": "header",
      "richText": [
        [
          "Real HTTP requests"
        ]
      ]
    },
    {
      "id": "testing-spring-boot-lesson-2-example-0",
      "type": "example",
      "example": {
        "title": "Call a running application on a random port",
        "language": "java",
        "description": [
          "Java `17` and Maven are required. The files form a separate project rooted at `pom.xml`.",
          "It has no database or security dependencies. A larger application also loads those configured components."
        ],
        "code": "",
        "explanation": [
          "`RANDOM_PORT` starts the embedded server without reserving a fixed port in the test.",
          "Boot provides `TestRestTemplate`, a test HTTP client configured for that server.",
          "The client sends a real request. The assertions check both the response status and body.",
          "Spring manages the server lifecycle for the test context."
        ],
        "commands": "mvn -Dtest=GreetingApplicationTest test",
        "files": [
          {
            "name": "src/main/java/com/example/demo/DemoApplication.java",
            "language": "java",
            "code": "package com.example.demo;\n\nimport org.springframework.boot.SpringApplication;\nimport org.springframework.boot.autoconfigure.SpringBootApplication;\n\n@SpringBootApplication\npublic class DemoApplication {\n    public static void main(String[] args) {\n        SpringApplication.run(DemoApplication.class, args);\n    }\n}\n"
          },
          {
            "name": "src/main/java/com/example/demo/GreetingController.java",
            "language": "java",
            "code": "package com.example.demo;\n\nimport org.springframework.web.bind.annotation.GetMapping;\nimport org.springframework.web.bind.annotation.RestController;\n\n@RestController\npublic class GreetingController {\n    @GetMapping(\"/hello\")\n    public String hello() {\n        return \"Hello, Spring Boot\";\n    }\n}\n"
          },
          {
            "name": "src/test/java/com/example/demo/GreetingApplicationTest.java",
            "language": "java",
            "code": "package com.example.demo;\n\nimport org.junit.jupiter.api.Test;\nimport org.springframework.beans.factory.annotation.Autowired;\nimport org.springframework.boot.test.context.SpringBootTest;\nimport org.springframework.boot.test.web.client.TestRestTemplate;\nimport static org.junit.jupiter.api.Assertions.assertEquals;\n\n@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)\nclass GreetingApplicationTest {\n    @Autowired\n    private TestRestTemplate client;\n\n    @Test\n    void servesGreeting() {\n        var response = client.getForEntity(\"/hello\", String.class);\n\n        assertEquals(200, response.getStatusCode().value());\n        assertEquals(\"Hello, Spring Boot\", response.getBody());\n    }\n}\n"
          },
          {
            "name": "pom.xml",
            "language": "text",
            "code": "<project xmlns=\"http://maven.apache.org/POM/4.0.0\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n         xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd\">\n    <modelVersion>4.0.0</modelVersion>\n    <parent>\n        <groupId>org.springframework.boot</groupId>\n        <artifactId>spring-boot-starter-parent</artifactId>\n        <version>3.5.16</version>\n        <relativePath/>\n    </parent>\n    <groupId>com.example</groupId>\n    <artifactId>demo</artifactId>\n    <version>1.0.0</version>\n    <properties><java.version>17</java.version></properties>\n    <dependencies>\n        <dependency>\n            <groupId>org.springframework.boot</groupId>\n            <artifactId>spring-boot-starter-web</artifactId>\n        </dependency>\n        <dependency>\n            <groupId>org.springframework.boot</groupId>\n            <artifactId>spring-boot-starter-test</artifactId>\n            <scope>test</scope>\n        </dependency>\n    </dependencies>\n    <build>\n        <finalName>demo</finalName>\n        <plugins>\n            <plugin>\n                <groupId>org.springframework.boot</groupId>\n                <artifactId>spring-boot-maven-plugin</artifactId>\n            </plugin>\n        </plugins>\n    </build>\n\n</project>\n"
          }
        ]
      }
    },
    {
      "id": "testing-spring-boot-lesson-3",
      "type": "header",
      "richText": [
        [
          "Mock requests with the full context"
        ]
      ]
    },
    {
      "id": "testing-spring-boot-lesson-3-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "@AutoConfigureMockMvc",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " adds the "
        ],
        [
          "MockMvc",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " support explained in the MVC-test lesson to a full-context test."
        ]
      ]
    },
    {
      "id": "testing-spring-boot-lesson-3-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "With the default "
        ],
        [
          "MOCK",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " environment, that combination exercises configured application beans without opening an HTTP port."
        ]
      ]
    },
    {
      "id": "testing-spring-boot-lesson-3-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "@WebMvcTest",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " and "
        ],
        [
          "@SpringBootTest",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " select different scopes. A single test class uses one of them."
        ]
      ]
    },
    {
      "id": "testing-spring-boot-lesson-4",
      "type": "header",
      "richText": [
        [
          "Test configuration and data"
        ]
      ]
    },
    {
      "id": "testing-spring-boot-lesson-4-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "@ActiveProfiles(\"test\")",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " activates a test profile. Its properties can select isolated databases and service endpoints."
        ]
      ]
    },
    {
      "id": "testing-spring-boot-lesson-4-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "A profile name alone does not create an isolated database. Its actual configuration determines the target."
        ]
      ]
    },
    {
      "id": "testing-spring-boot-lesson-4-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "A transactional test can roll back changes performed in its own transaction."
        ]
      ]
    },
    {
      "id": "testing-spring-boot-lesson-4-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "An HTTP server handles requests on another thread. A transaction around the test method does not automatically roll back that server-side work."
        ]
      ]
    },
    {
      "id": "testing-spring-boot-lesson-4-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "Real-server tests need data setup and cleanup that follow those server-side transaction boundaries."
        ]
      ]
    },
    {
      "id": "testing-spring-boot-lesson-4-note-5",
      "type": "bulleted_list",
      "richText": [
        [
          "A local application test does not prove that a deployed host has the same settings or can reach its external services."
        ]
      ]
    }
  ],
