    },
    {
      "id": "testing-spring-boot-lesson-0-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "A test can specify the startup configuration explicitly with "
        ],
        [
          "classes",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "testing-spring-boot-lesson-0-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "A context-startup test checks that the beans can be created. Assertions are still needed for application behavior."
        ]
      ]
    },
