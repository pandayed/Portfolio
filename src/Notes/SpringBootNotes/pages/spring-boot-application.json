      "richText": [
        [
          "Component Scanning",
          [
            [
              "b"
            ]
          ]
        ],
        [
          ": Works through "
        ],
        [
          "@ComponentScan",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " — helps find "
        ],
        [
          "@Component",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ", "
        ],
        [
          "@Service",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ", "
        ],
        [
          "@Controller",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ", etc."
        ]
      ]
    },
    {
