      "richText": [
        [
          "5. "
        ],
        [
          "Best Practices & Pitfalls",
          [
            [
              "b"
            ]
          ]
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-800c-9302-fa029236ebfe",
      "type": "sub_sub_header",
      "richText": [
        [
          "✅ Best Practices"
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-8022-a555-d3de30aee61f",
      "type": "bulleted_list",
      "richText": [
        [
          "Place "
        ],
        [
          "@SpringBootApplication",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " in the "
        ],
        [
          "root package",
          [
            [
              "b"
            ]
          ]
        ],
        [
          " of your project so that component scanning includes all sub-packages."
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-80e9-b33f-ffab4b46b6d0",
      "type": "bulleted_list",
      "richText": [
        [
          "Use it only "
        ],
        [
          "once",
          [
            [
              "b"
            ]
          ]
        ],
        [
          " in the main class (avoid multiple startup classes unless in complex modular apps)."
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-80b1-baf5-e74544c6792b",
      "type": "bulleted_list",
      "richText": [
        [
          "Combine it with proper package structure to ensure Spring picks up your components."
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-802d-8147-c8b8c2716837",
      "type": "sub_sub_header",
      "richText": [
        [
          "❌ Common Pitfalls"
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-803d-aa72-eaa92341b1ee",
      "type": "bulleted_list",
      "richText": [
        [
          "Placing it in a "
        ],
        [
          "deep sub-package",
          [
            [
              "b"
            ]
          ]
        ],
        [
          " — Spring won't scan sibling or parent packages by default."
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-8001-9798-fde0b0896c82",
      "type": "bulleted_list",
      "richText": [
        [
          "Ignoring logs — if auto-configuration fails, Spring Boot prints helpful info in the logs that you shouldn’t skip."
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-8083-8349-ebc33943b374",
      "type": "bulleted_list",
      "richText": [
        [
          "Forgetting to include a "
        ],
        [
          "main()",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " method to run the application."
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-800f-8b8b-e6d6ecf8597f",
      "type": "divider"
    },
