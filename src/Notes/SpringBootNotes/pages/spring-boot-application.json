          "@EnableAutoConfiguration",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ", sets up things like database configs automatically."
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-8044-a759-dc34e27dcbc1",
      "type": "bulleted_list",
      "richText": [
        [
          "Spring Beans",
          [
            [
              "b"
            ]
          ]
        ],
        [
          ": Objects created and managed by Spring, loaded thanks to configuration and scanning."
        ]
      ]
    },
    {
