      "richText": [
        [
          "@SpringBootApplication"
        ]
      ]
    },
    {
      "id": "spring-boot-application-lesson-1-point-0",
      "type": "bulleted_list",
      "richText": [
        [
          "@SpringBootApplication",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " combines "
        ],
        [
          "@SpringBootConfiguration",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ", "
        ],
        [
          "@ComponentScan",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ", and "
