    {
      "id": "spring-boot-application-configuration",
      "type": "header",
      "richText": [
        [
          "@SpringBootConfiguration"
        ]
      ]
    },
    {
      "id": "spring-boot-application-configuration-point-0",
      "type": "bulleted_list",
      "richText": [
        [
          "@SpringBootConfiguration",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " identifies the main configuration class of a Spring Boot application."
        ]
      ]
    },
    {
      "id": "spring-boot-application-configuration-point-1",
      "type": "bulleted_list",
      "richText": [
        [
          "It is a specialized "
        ],
        [
          "@Configuration",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ", so that class can also declare "
        ],
        [
          "@Bean",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " methods."
        ]
      ]
    },
    {
      "id": "spring-boot-application-configuration-point-2",
      "type": "bulleted_list",
      "richText": [
        [
          "Boot-specific features, including application tests, can use this marker to locate the main configuration."
        ]
      ]
    },
    {
      "id": "spring-boot-application-configuration-point-3",
      "type": "bulleted_list",
      "richText": [
        [
          "This is the configuration part of "
        ],
        [
          "@SpringBootApplication",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ". It is not a fourth, separate annotation to add beside it."
        ]
      ]
    },
    {
      "id": "spring-boot-application-scanning",
      "type": "header",
      "richText": [
        [
          "@ComponentScan"
        ]
      ]
    },
    {
      "id": "spring-boot-application-scanning-point-0",
      "type": "bulleted_list",
      "richText": [
        [
          "@ComponentScan",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " finds application classes marked with component annotations and registers their bean definitions."
        ]
      ]
    },
    {
      "id": "spring-boot-application-scanning-point-1",
      "type": "bulleted_list",
      "richText": [
        [
          "This includes "
        ],
        [
          "@Component",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ", "
        ],
        [
          "@Service",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ", "
        ],
        [
          "@Repository",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ", and "
        ],
        [
          "@Configuration",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " classes."
        ]
      ]
    },
    {
      "id": "spring-boot-application-scanning-point-2",
      "type": "bulleted_list",
      "richText": [
        [
          "With "
        ],
        [
          "DemoApplication",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " in "
        ],
        [
          "com.example.demo",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ", the default search includes "
        ],
        [
          "com.example.demo",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " and its subpackages."
        ]
      ]
    },
    {
      "id": "spring-boot-application-scanning-point-3",
      "type": "bulleted_list",
      "richText": [
        [
          "For example, a "
        ],
        [
          "GreetingService",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " marked with "
        ],
        [
          "@Service",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " in that package becomes a bean that Spring can create and inject."
        ]
      ]
    },
    {
      "id": "spring-boot-application-scanning-point-4",
      "type": "bulleted_list",
      "richText": [
        [
          "A class outside those packages is not included in that default component search."
        ]
      ]
    },
    {
      "id": "spring-boot-application-auto-configuration",
      "type": "header",
      "richText": [
        [
          "@EnableAutoConfiguration"
        ]
      ]
    },
    {
      "id": "spring-boot-application-auto-configuration-point-0",
      "type": "bulleted_list",
      "richText": [
        [
          "@EnableAutoConfiguration",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " lets Boot supply framework configuration when its conditions match."
        ]
      ]
    },
    {
      "id": "spring-boot-application-auto-configuration-point-1",
      "type": "bulleted_list",
      "richText": [
        [
          "Boot considers the available libraries, existing beans, and relevant settings."
        ]
      ]
    },
    {
      "id": "spring-boot-application-auto-configuration-point-2",
      "type": "bulleted_list",
      "richText": [
        [
          "For example, the Spring Web dependencies let Boot configure Spring MVC and an embedded servlet server."
        ]
      ]
    },
    {
      "id": "spring-boot-application-auto-configuration-point-3",
      "type": "bulleted_list",
      "richText": [
        [
          "Component scanning finds application components. Auto-configuration supplies framework setup for the libraries the application uses."
        ]
      ]
    },
    {
      "id": "spring-boot-application-auto-configuration-point-4",
      "type": "bulleted_list",
      "richText": [
        [
          "The auto-configuration lesson explains matching conditions and how an application can replace particular defaults."
        ]
      ]
    },
    {
