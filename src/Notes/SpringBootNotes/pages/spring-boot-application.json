      "type": "header",
      "richText": [
        [
          "Application startup"
        ]
      ]
    },
    {
      "id": "spring-boot-application-lesson-0-point-0",
      "type": "numbered_list",
      "richText": [
        [
          "main",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " calls "
        ],
        [
          "SpringApplication.run(DemoApplication.class, args)",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "spring-boot-application-lesson-0-point-1",
      "type": "numbered_list",
      "richText": [
        [
          "Boot uses "
        ],
        [
          "DemoApplication",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " as its primary configuration class and prepares the application settings."
        ]
      ]
    },
    {
      "id": "spring-boot-application-lesson-0-point-2",
      "type": "numbered_list",
      "richText": [
        [
          "Spring processes the application configuration, discovers component definitions, and applies matching auto-configuration."
        ]
      ]
    },
    {
      "id": "spring-boot-application-lesson-0-point-3",
      "type": "numbered_list",
      "richText": [
        [
          "The application context creates the required beans and supplies their dependencies."
        ]
      ]
    },
    {
      "id": "spring-boot-application-lesson-0-point-4",
      "type": "numbered_list",
      "richText": [
        [
          "For this servlet web application, startup also starts the embedded server."
        ]
      ]
    },
    {
