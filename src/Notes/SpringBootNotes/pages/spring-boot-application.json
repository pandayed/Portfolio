      "type": "numbered_list",
      "richText": [
        [
          "What does "
        ],
        [
          "@SpringBootApplication",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " do behind the scenes?"
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-80a4-beb2-e892922e53d9",
      "type": "numbered_list",
      "richText": [
        [
          "How does component scanning work in Spring Boot?"
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-80a9-9ccc-c81d05d86ce2",
      "type": "numbered_list",
      "richText": [
        [
          "What is the difference between "
        ],
        [
          "@Configuration",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " and "
        ],
        [
          "@Component",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "?"
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-806e-8a5b-e9d69d0fb23a",
      "type": "numbered_list",
      "richText": [
        [
          "What happens if you remove "
        ],
        [
          "@SpringBootApplication",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " from your main class?"
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-80ac-b2e9-c862e636126e",
      "type": "numbered_list",
      "richText": [
        [
          "Can you customize or override the behavior of "
        ],
