      "richText": [
        [
          "Actuator endpoints"
        ]
      ]
    },
    {
      "id": "actuator-lesson-0-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "Spring Boot Actuator adds management endpoints to a running application."
        ]
      ]
    },
    {
      "id": "actuator-lesson-0-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "spring-boot-starter-actuator",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " supplies this support. The application still uses its usual startup class."
        ]
      ]
    },
    {
      "id": "actuator-lesson-0-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "A management endpoint reports runtime information or performs a management operation."
        ]
      ]
    },
    {
      "id": "actuator-lesson-0-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "In a web application, the default URL prefix is "
        ],
        [
          "/actuator",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "actuator-lesson-0-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "Only "
        ],
        [
          "health",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " is exposed over HTTP by default."
        ]
      ]
    },
