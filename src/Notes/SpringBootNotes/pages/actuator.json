      "type": "header",
      "richText": [
        [
          "Inspect a running application"
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-803d-bd2d-d2155da2c88b-b0",
      "type": "bulleted_list",
      "richText": [
        [
          "Spring Boot Actuator adds endpoints for health, metrics, and other runtime information."
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-803d-bd2d-d2155da2c88b-b1",
      "type": "bulleted_list",
      "richText": [
        [
          "Add spring-boot-starter-actuator to enable it."
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-803d-bd2d-d2155da2c88b-b2",
      "type": "bulleted_list",
      "richText": [
        [
          "In a web application, the default endpoint prefix is /actuator."
        ]
      ]
    },
    {
      "id": "20824eb1-ed54-803d-bd2d-d2155da2c88b-b3",
      "type": "bulleted_list",
      "richText": [
        [
          "Only health is exposed over HTTP by default. Expose other endpoints explicitly."
        ]
      ]
    },
