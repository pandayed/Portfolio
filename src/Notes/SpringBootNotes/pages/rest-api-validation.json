              [
                "@Size(max = 40)",
                [
                  [
                    "c"
                  ]
                ]
              ]
            ],
            "1": [
              [
                "The supported value has at most "
              ],
              [
                "40",
                [
                  [
                    "c"
                  ]
                ]
              ],
              [
                " characters or elements."
              ]
            ]
          }
        },
        {
