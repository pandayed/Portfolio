  "blocks": [
    {
      "id": "rest-api-validation-lesson-0",
      "type": "header",
      "richText": [
        [
          "Validation constraints"
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-0-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "Bean Validation checks a Java object against rules declared with constraint annotations."
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-0-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "spring-boot-starter-validation",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " supplies the validation implementation for a Spring Boot application."
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-0-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "Spring Boot 3 uses "
        ],
        [
          "jakarta.validation",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " imports. Older Boot 2 tutorials use "
        ],
        [
          "javax.validation",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-0-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "A request DTO keeps input constraints beside the fields they apply to."
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-0-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "A constraint only checks its declared rule. It does not check permissions or whether a database record exists."
        ]
      ]
    },
    {
