                  ]
                ]
              ]
            ],
            "1": [
              [
                "The string, collection, map, or array is not "
              ],
              [
                "null",
                [
                  [
                    "c"
                  ]
                ]
              ],
              [
                " or empty."
              ]
            ]
          }
        },
        {
          "id": "rest-api-validation-lesson-0-table-0-row-4",
          "type": "table_row",
          "cells": {
