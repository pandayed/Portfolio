              [
                "@Email",
                [
                  [
                    "c"
                  ]
                ]
              ]
            ],
            "1": [
              [
                "A non-null string has an accepted email format."
              ]
            ]
          }
        }
      ]
    },
    {
      "id": "rest-api-validation-lesson-1",
      "type": "header",
      "richText": [
        [
          "Request validation with "
        ],
        [
          "@Valid",
          [
            [
              "c"
            ]
          ]
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-1-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "@Valid",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " on a "
        ],
        [
          "@RequestBody",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " argument asks Spring MVC to validate the converted DTO."
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-1-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "JSON conversion runs first. Validation checks the resulting Java object."
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-1-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "For this argument validation, a failed constraint prevents the handler method from running."
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-1-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "Spring raises "
        ],
        [
          "MethodArgumentNotValidException",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " and normally responds with "
        ],
        [
          "400 Bad Request",
          [
            [
              "c"
            ]
          ]
        ],
        [
          "."
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-1-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "A successful conversion does not imply successful validation."
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-1-note-5",
      "type": "bulleted_list",
      "richText": [
        [
          "A constraint such as "
        ],
        [
          "@Size",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " or "
        ],
        [
          "@Email",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " can allow "
        ],
        [
          "null",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ". A required field also needs a suitable required-value constraint."
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-1-example-0",
      "type": "example",
      "example": {
        "title": "Reject a blank or overlong greeting name",
        "language": "java",
        "description": [
          "Each example is a separate project. All required application files appear in the tabs.",
          "The validation starter uses the Spring Boot dependency version managed by the project.",
          "The commands run after the application restarts and assume port `8080`.",
          "`mvn spring-boot:run` starts the application from the directory containing `pom.xml`. Requests run in a second terminal."
        ],
        "code": "",
        "explanation": [
          "The first request passes both constraints and returns `200` with a greeting.",
          "The second request fails `@NotBlank` and returns `400` before `greet()` runs.",
          "`@Size` rejects names longer than `40` characters.",
          "The default error body may omit the declared messages.",
          "The next lesson, Controller exception handling, gives validation failures a chosen error body."
        ],
        "commands": "curl -i -X POST http://localhost:8080/greetings \\\n  -H 'Content-Type: application/json' -d '{\"name\":\"Ada\"}'\ncurl -i -X POST http://localhost:8080/greetings \\\n  -H 'Content-Type: application/json' -d '{\"name\":\" \"}'",
        "files": [
          {
            "name": "src/main/java/com/example/demo/GreetingController.java",
            "language": "java",
            "code": "package com.example.demo;\n\nimport jakarta.validation.Valid;\nimport jakarta.validation.constraints.NotBlank;\nimport jakarta.validation.constraints.Size;\nimport org.springframework.web.bind.annotation.PostMapping;\nimport org.springframework.web.bind.annotation.RequestBody;\nimport org.springframework.web.bind.annotation.RequestMapping;\nimport org.springframework.web.bind.annotation.RestController;\n\n@RestController\n@RequestMapping(\"/greetings\")\npublic class GreetingController {\n    public record GreetingRequest(\n        @NotBlank(message = \"Name is required\")\n        @Size(max = 40, message = \"Name must have at most 40 characters\")\n        String name\n    ) {}\n\n    public record GreetingResponse(String message) {}\n\n    @PostMapping\n    public GreetingResponse greet(@Valid @RequestBody GreetingRequest request) {\n        return new GreetingResponse(\"Hello, \" + request.name());\n    }\n}\n"
          },
          {
            "name": "pom.xml",
            "language": "text",
            "code": "<project xmlns=\"http://maven.apache.org/POM/4.0.0\" xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n         xsi:schemaLocation=\"http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd\">\n    <modelVersion>4.0.0</modelVersion>\n    <parent>\n        <groupId>org.springframework.boot</groupId>\n        <artifactId>spring-boot-starter-parent</artifactId>\n        <version>3.5.16</version>\n        <relativePath/>\n    </parent>\n    <groupId>com.example</groupId>\n    <artifactId>demo</artifactId>\n    <version>1.0.0</version>\n    <properties><java.version>17</java.version></properties>\n    <dependencies>\n        <dependency>\n            <groupId>org.springframework.boot</groupId>\n            <artifactId>spring-boot-starter-web</artifactId>\n        </dependency>\n        <dependency>\n            <groupId>org.springframework.boot</groupId>\n            <artifactId>spring-boot-starter-validation</artifactId>\n        </dependency>\n    </dependencies>\n    <build>\n        <finalName>demo</finalName>\n        <plugins>\n            <plugin>\n                <groupId>org.springframework.boot</groupId>\n                <artifactId>spring-boot-maven-plugin</artifactId>\n            </plugin>\n        </plugins>\n    </build>\n\n</project>\n"
          },
          {
            "name": "src/main/java/com/example/demo/DemoApplication.java",
            "language": "java",
            "code": "package com.example.demo;\n\nimport org.springframework.boot.SpringApplication;\nimport org.springframework.boot.autoconfigure.SpringBootApplication;\n\n@SpringBootApplication\npublic class DemoApplication {\n    public static void main(String[] args) {\n        SpringApplication.run(DemoApplication.class, args);\n    }\n}\n"
          }
        ]
      }
    },
    {
      "id": "rest-api-validation-lesson-2",
      "type": "header",
      "richText": [
        [
          "Nested objects and other validation paths"
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-2-note-0",
      "type": "bulleted_list",
      "richText": [
        [
          "@Valid",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " on a nested DTO field also validates that object's constraints."
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-2-note-1",
      "type": "bulleted_list",
      "richText": [
        [
          "A required nested object also needs "
        ],
        [
          "@NotNull",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ". Cascaded validation does not reject an absent object by itself."
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-2-note-2",
      "type": "bulleted_list",
      "richText": [
        [
          "BindingResult",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " immediately after a validated argument lets the handler inspect that argument's errors instead of relying on the usual exception."
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-2-note-3",
      "type": "bulleted_list",
      "richText": [
        [
          "That handler must check the errors before processing the input."
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-2-note-4",
      "type": "bulleted_list",
      "richText": [
        [
          "Spring MVC 6.1 and later can validate constraints directly on handler parameters, such as "
        ],
        [
          "@Min(1)",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " on a numeric parameter."
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-2-note-5",
      "type": "bulleted_list",
      "richText": [
        [
          "That method-validation path can raise "
        ],
        [
          "HandlerMethodValidationException",
          [
            [
              "c"
            ]
          ]
        ],
        [
          ", which differs from request DTO validation."
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-2-note-6",
      "type": "bulleted_list",
      "richText": [
        [
          "@Validated",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " on a configuration properties type runs its constraints during startup. Invalid configuration fails startup rather than returning an HTTP response."
        ]
      ]
    },
    {
      "id": "rest-api-validation-lesson-2-note-7",
      "type": "bulleted_list",
      "richText": [
        [
          "An application-specific validation annotation uses "
        ],
        [
          "@Constraint",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " and a "
        ],
        [
          "ConstraintValidator",
          [
            [
              "c"
            ]
          ]
        ],
        [
          " implementation. The built-in constraints cover the rules in this lesson."
        ]
      ]
    }
  ],
