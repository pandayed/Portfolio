              [
                "The string is not "
              ],
              [
                "null",
                [
                  [
                    "c"
                  ]
                ]
              ],
              [
                " and contains a non-whitespace character."
              ]
            ]
          }
        },
        {
          "id": "rest-api-validation-lesson-0-table-0-row-3",
          "type": "table_row",
          "cells": {
