      "text": "Coordinator → All Participants: ABORT(transaction_id)"
    },
    {
      "id": "26d24eb1ed54802ab561cb8a5f408c13",
      "type": "text",
      "html": "<span style=\"font-weight:600\" data-token-index=\"0\" class=\"notion-enable-hover\">Coordinator Actions:</span>",
      "text": "Coordinator Actions:"
    },
    {
      "id": "26d24eb1ed5480848765e5e40f8e5695",
      "type": "bulleted_list",
      "html": "Log the decision before sending messages",
      "text": "Log the decision before sending messages"
    },
    {
      "id": "26d24eb1ed54809c8572f40947f9e3d0",
      "type": "bulleted_list",
      "html": "Start timeout timers for acknowledgments",
