      "type": "bulleted_list",
      "parent": "27524eb1ed54804a8902d73c12aaded6",
      "html": "<span style=\"font-weight:600\" data-token-index=\"0\" class=\"notion-enable-hover\">Storage</span>: unit size × count × replication × growth",
      "text": "Storage: unit size × count × replication × growth"
    },
