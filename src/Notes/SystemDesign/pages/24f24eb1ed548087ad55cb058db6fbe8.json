      "id": "27524eb1ed5480998ff0cbd28fe00a7e",
      "type": "bulleted_list",
      "parent": "27524eb1ed5480a6a4bbff07754e78e9",
      "html": "DAU (Daily Active Users).",
      "text": "DAU (Daily Active Users)."
    },
    {
      "id": "27524eb1ed5480abafaff01b164485ac",
      "type": "bulleted_list",
      "parent": "27524eb1ed5480a6a4bbff07754e78e9",
      "html": "MAU (Monthly Active Users).",
      "text": "MAU (Monthly Active Users)."
    },
