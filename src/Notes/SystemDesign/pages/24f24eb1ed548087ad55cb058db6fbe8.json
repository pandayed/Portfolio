    {
      "id": "27524eb1ed5480509006d6bb26c8c4b3",
      "type": "bulleted_list",
      "html": "<span style=\"font-weight:600\" data-token-index=\"0\" class=\"notion-enable-hover\">Storage Systems</span>",
      "text": "Storage Systems"
    },
    {
      "id": "27524eb1ed5480d59c16cce7e6577554",
      "type": "bulleted_list",
      "parent": "27524eb1ed5480509006d6bb26c8c4b3",
      "html": "Object storage (e.g., S3) for files, photos, videos.",
      "text": "Object storage (e.g., S3) for files, photos, videos."
    },
    {
      "id": "27524eb1ed5480cd8bcafd8c3dd021a6",
      "type": "bulleted_list",
      "parent": "27524eb1ed5480509006d6bb26c8c4b3",
      "html": "Estimate = file size × upload rate × retention × replication.",
      "text": "Estimate = file size × upload rate × retention × replication."
    },
    {
      "id": "27524eb1ed54801da512ed411ab4c550",
      "type": "bulleted_list",
      "html": "<span style=\"font-weight:600\" data-token-index=\"0\" class=\"notion-enable-hover\">Message Queues / Streams</span> (if needed)",
      "text": "Message Queues / Streams (if needed)"
    },
    {
      "id": "27524eb1ed548089a56fed103b28f638",
      "type": "bulleted_list",
      "parent": "27524eb1ed54801da512ed411ab4c550",
      "html": "Handle async workloads (notifications, logs, analytics).",
      "text": "Handle async workloads (notifications, logs, analytics)."
    },
    {
      "id": "27524eb1ed54806c9b02f5a177c13a74",
      "type": "bulleted_list",
      "parent": "27524eb1ed54801da512ed411ab4c550",
      "html": "Estimate = message size × message rate.",
      "text": "Estimate = message size × message rate."
    },
    {
      "id": "27524eb1ed5480e0859fd7a57c2c4a3c",
      "type": "bulleted_list",
      "html": "<span style=\"font-weight:600\" data-token-index=\"0\" class=\"notion-enable-hover\">Analytics / Logging Systems</span>",
      "text": "Analytics / Logging Systems"
    },
    {
      "id": "27524eb1ed5480ea981fcde07e060a8d",
      "type": "bulleted_list",
      "parent": "27524eb1ed5480e0859fd7a57c2c4a3c",
      "html": "Often generate more data than the app itself.",
      "text": "Often generate more data than the app itself."
    },
    {
      "id": "27524eb1ed5480858aa9eafe2554ecd7",
      "type": "bulleted_list",
      "parent": "27524eb1ed5480e0859fd7a57c2c4a3c",
      "html": "Must estimate log volume separately.",
      "text": "Must estimate log volume separately."
    },
    {
      "id": "27524eb1ed548040a0a1ca050c204408",
      "type": "sub_sub_header",
      "html": "Why this matters",
      "text": "Why this matters"
    },
    {
      "id": "27524eb1ed5480e08b9ff5d64a6d4049",
      "type": "bulleted_list",
      "html": "Ensures <span style=\"font-weight:600\" data-token-index=\"1\" class=\"notion-enable-hover\">no blind spots</span> (many miss caches, logging, or CDN).",
      "text": "Ensures no blind spots (many miss caches, logging, or CDN)."
    },
    {
      "id": "27524eb1ed5480e595edec5d8696983f",
      "type": "bulleted_list",
      "html": "Breaks down a complex system into <span style=\"font-weight:600\" data-token-index=\"1\" class=\"notion-enable-hover\">manageable units</span> for estimation.",
      "text": "Breaks down a complex system into manageable units for estimation."
    },
    {
      "id": "27524eb1ed5480888927f526ab07ac00",
      "type": "bulleted_list",
      "html": "In interviews, shows you can think <span style=\"font-weight:600\" data-token-index=\"1\" class=\"notion-enable-hover\">holistically</span>, not just about databases.",
      "text": "In interviews, shows you can think holistically, not just about databases."
    },
